#!/usr/bin/env bash
# 物理拦截 Git(开发铁律第 3 条:完全禁用,含 status/diff 等只读命令)。
# 由 .zcode/config.json 的 PreToolUse hook(matcher: Bash)调用:
# stdin 收到 hook JSON,检出 tool_input.command 中的 git 调用则 exit 2 拒绝。
set -u

hook_input=$(cat)

HOOK_INPUT="$hook_input" exec /usr/bin/python3 -c '
import json, os, re, sys

raw = os.environ.get("HOOK_INPUT", "")
command = ""
try:
    data = json.loads(raw)
    tool_input = data.get("tool_input") or {}
    if isinstance(tool_input, dict):
        command = tool_input.get("command") or ""
except Exception:
    command = raw  # JSON 解析失败时退回全文扫描,宁可错拦不可漏拦

# 独立成词的 git(兼容 /usr/bin/git、子 shell、管道等形态);
# 不匹配 github、legit 等仅包含 "git" 字样的词。
pattern = re.compile(r"(^|[^A-Za-z0-9_.-])git([^A-Za-z0-9_-]|$)")
if isinstance(command, str) and pattern.search(command):
    sys.stderr.write(
        "已拒绝:开发铁律第 3 条完全禁用 Git 操作(含 status/diff 等只读命令)。"
        "本项目不使用版本控制,请勿尝试绕过。"
    )
    sys.exit(2)
sys.exit(0)
'
