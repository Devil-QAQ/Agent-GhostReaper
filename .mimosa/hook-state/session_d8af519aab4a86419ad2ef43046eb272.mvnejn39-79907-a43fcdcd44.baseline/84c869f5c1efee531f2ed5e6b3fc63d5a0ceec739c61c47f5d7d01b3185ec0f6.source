package overmind

import (
	"context"
	"encoding/json"
	"strconv"
	"strings"
	"testing"
	"time"

	"ghostreaper/internal/rings"
)

// ---- P4-18 收口信号(问题清单 #30)确定性单测 ----
// 双条件判定(轮数 + 间隔,缺一不弹)/ 锚点清零(新发现、继续各自
// 重计)/ 待决守卫(不重复弹)/ 阈值全局键生效 / cycle 挂接(prompt 由
// 真实研判轮落账路径触发,任务不被打断)/ 结束键走收尾时序
//(SettleNow → settle,settled_by=closure_prompt)。

// mkTaskAt 建任务行,created 时刻可回拨(时间条件判定的确定性锚)。
func mkTaskAt(t *testing.T, store *rings.Store, task string, created time.Time) {
	t.Helper()
	if _, err := store.Append(context.Background(), task, rings.Event{
		Kind: rings.EventTaskLifecycle, Actor: "manager", OccurredAt: created,
		Payload: rings.TaskLifecycle{Action: "created", Title: task},
	}); err != nil {
		t.Fatalf("建任务失败: %v", err)
	}
}

// noteAssessment 落一轮研判记录(研判轮锚点)。
func noteAssessment(t *testing.T, store *rings.Store, task string) {
	t.Helper()
	if _, err := store.Append(context.Background(), task, rings.Event{
		Kind: rings.EventOvermindRecord, Actor: ActorOvermind,
		Payload: rings.OvermindRecord{Type: rings.OvermindRecAssessment, Note: "无新发现", EvaluatedRev: 1},
	}); err != nil {
		t.Fatalf("落研判记录失败: %v", err)
	}
}

// seedFindingAt 种一个新发现(事实节点新增),时刻可回拨。
func seedFindingAt(t *testing.T, store *rings.Store, task, id string, at time.Time) {
	t.Helper()
	if _, err := store.Append(context.Background(), task, rings.Event{
		Kind: rings.EventNodeAdded, Actor: "swarm:u1", OccurredAt: at,
		Payload: rings.NodeAdded{NodeID: id, NodeType: rings.NodeFact, Title: "事实 " + id, Status: "candidate"},
	}); err != nil {
		t.Fatalf("种新发现失败: %v", err)
	}
}

// setClosureKeys 写收口阈值全局键(Agent 栏同一键)。
func setClosureKeys(t *testing.T, store *rings.Store, rounds, minutes int) {
	t.Helper()
	ctx := context.Background()
	if err := store.SetSetting(ctx, SettingKeyClosureRounds, strconv.Itoa(rounds), "creator"); err != nil {
		t.Fatalf("写轮数键失败: %v", err)
	}
	if err := store.SetSetting(ctx, SettingKeyClosureMinutes, strconv.Itoa(minutes), "creator"); err != nil {
		t.Fatalf("写间隔键失败: %v", err)
	}
}

// closurePrompts 取任务内全部收口提醒记录(按落账次序)。
func closurePrompts(t *testing.T, store *rings.Store, task string) []rings.ClosureRecord {
	t.Helper()
	evs, err := store.Events(context.Background(), task, 0, 0)
	if err != nil {
		t.Fatalf("查事件流失败: %v", err)
	}
	var out []rings.ClosureRecord
	for _, ev := range evs {
		if ev.Kind != rings.EventClosureRecord {
			continue
		}
		var r rings.ClosureRecord
		if json.Unmarshal(ev.Payload, &r) != nil {
			t.Fatalf("解码收口记录失败: %s", ev.Payload)
		}
		if r.Type == rings.ClosureRecPrompt {
			out = append(out, r)
		}
	}
	return out
}

// TestClosureDoubleCondition 双条件判定:轮数与间隔同时满足才弹;单边
// 满足不弹;弹出后待决守卫(不重复弹);快照数字与阈值随提醒落账。
func TestClosureDoubleCondition(t *testing.T) {
	store := openStore(t)
	ctx := context.Background()
	const task = "closure-cond"
	setClosureKeys(t, store, 2, 30)
	mkTaskAt(t, store, task, time.Now().Add(-40*time.Minute))

	l := &Loop{TaskID: task, Store: store}
	noteAssessment(t, store, task)
	l.evalClosure(ctx)
	if ps := closurePrompts(t, store, task); len(ps) != 0 {
		t.Fatalf("轮数未达阈值不应弹: %d", len(ps))
	}
	st, err := ClosureOf(ctx, store, task)
	if err != nil {
		t.Fatalf("推导失败: %v", err)
	}
	if st.Rounds != 1 || st.AnchorKind != rings.ClosureAnchorCreated {
		t.Fatalf("应计 1 轮、锚点=建任务: %+v", st)
	}

	// 间隔 40 分钟 ≥30、轮数 2 达阈 → 弹;快照字段齐。
	noteAssessment(t, store, task)
	l.evalClosure(ctx)
	ps := closurePrompts(t, store, task)
	if len(ps) != 1 {
		t.Fatalf("双条件满足应恰弹 1 次: %d", len(ps))
	}
	p := ps[0]
	if p.Rounds != 2 || p.RoundsThreshold != 2 || p.MinutesThreshold != 30 || p.AnchorKind != rings.ClosureAnchorCreated {
		t.Fatalf("提醒快照不符: %+v", p)
	}
	if p.Minutes < 40 {
		t.Fatalf("距锚点分钟数应 ≥40: %d", p.Minutes)
	}
	if _, err := time.Parse(time.RFC3339, p.AnchorAt); err != nil {
		t.Fatalf("锚点时刻不可解析: %v", err)
	}

	// 待决守卫:再评估不重复弹。
	noteAssessment(t, store, task)
	l.evalClosure(ctx)
	if ps := closurePrompts(t, store, task); len(ps) != 1 {
		t.Fatalf("待决期间不应重复弹: %d", len(ps))
	}
	st, _ = ClosureOf(ctx, store, task)
	if st.Pending == nil || st.Rounds != 3 {
		t.Fatalf("待决态与轮数应如实: %+v", st)
	}
}

// TestClosureTimeNotMet 轮数已足但间隔未到不弹(双条件缺一不可)。
func TestClosureTimeNotMet(t *testing.T) {
	store := openStore(t)
	ctx := context.Background()
	const task = "closure-time"
	setClosureKeys(t, store, 2, 30)
	mkTaskAt(t, store, task, time.Now().Add(-5*time.Minute))
	l := &Loop{TaskID: task, Store: store}
	for i := 0; i < 3; i++ {
		noteAssessment(t, store, task)
	}
	l.evalClosure(ctx)
	if ps := closurePrompts(t, store, task); len(ps) != 0 {
		t.Fatalf("间隔未到不应弹: %d", len(ps))
	}
	st, _ := ClosureOf(ctx, store, task)
	if st.Rounds != 3 {
		t.Fatalf("轮数应如实累计: %+v", st)
	}
}

// TestClosureFindingResets 新发现清零重计:待决提醒随之解决,计数从
// 新发现重新起算,再次双条件满足后弹出(锚点种类=新发现)。
func TestClosureFindingResets(t *testing.T) {
	store := openStore(t)
	ctx := context.Background()
	const task = "closure-finding"
	setClosureKeys(t, store, 2, 30)
	mkTaskAt(t, store, task, time.Now().Add(-40*time.Minute))
	l := &Loop{TaskID: task, Store: store}
	noteAssessment(t, store, task)
	noteAssessment(t, store, task)
	l.evalClosure(ctx)
	if ps := closurePrompts(t, store, task); len(ps) != 1 {
		t.Fatalf("前置:双条件满足应弹 1 次: %d", len(ps))
	}

	seedFindingAt(t, store, task, "f-1", time.Now().Add(-40*time.Minute))
	st, err := ClosureOf(ctx, store, task)
	if err != nil {
		t.Fatalf("推导失败: %v", err)
	}
	if st.Pending != nil || st.Rounds != 0 || st.AnchorKind != rings.ClosureAnchorFinding {
		t.Fatalf("新发现应清零重计并解决待决: %+v", st)
	}
	// 新锚点下再攒满双条件 → 第二次弹出。
	noteAssessment(t, store, task)
	noteAssessment(t, store, task)
	l.evalClosure(ctx)
	ps := closurePrompts(t, store, task)
	if len(ps) != 2 || ps[1].AnchorKind != rings.ClosureAnchorFinding {
		t.Fatalf("应基于新发现锚点再次弹出: %+v", ps)
	}
}

// TestClosureContinueResets 「继续」重计:待决解除、锚点移到本次「继续」;
// 同规则攒满后再次弹出(防反复打断的间隔即由此重起)。
func TestClosureContinueResets(t *testing.T) {
	store := openStore(t)
	ctx := context.Background()
	const task = "closure-continue"
	setClosureKeys(t, store, 2, 30)
	mkTaskAt(t, store, task, time.Now().Add(-40*time.Minute))
	l := &Loop{TaskID: task, Store: store}
	noteAssessment(t, store, task)
	noteAssessment(t, store, task)
	l.evalClosure(ctx)
	if ps := closurePrompts(t, store, task); len(ps) != 1 {
		t.Fatalf("前置:应弹 1 次: %d", len(ps))
	}

	// 造物主选「继续」(面板动作;回拨到 40 分钟前以确定性满足再弹的
	// 间隔条件)。
	if _, err := store.Append(ctx, task, rings.Event{
		Kind: rings.EventClosureRecord, Actor: "creator",
		OccurredAt: time.Now().Add(-40 * time.Minute),
		Payload:    rings.ClosureRecord{Type: rings.ClosureRecContinue},
	}); err != nil {
		t.Fatalf("落「继续」记录失败: %v", err)
	}
	st, _ := ClosureOf(ctx, store, task)
	if st.Pending != nil || st.Rounds != 0 || st.AnchorKind != rings.ClosureAnchorContinue {
		t.Fatalf("「继续」应清零重计: %+v", st)
	}
	noteAssessment(t, store, task)
	l.evalClosure(ctx) // 轮数 1 < 2:不弹
	if ps := closurePrompts(t, store, task); len(ps) != 1 {
		t.Fatalf("轮数未足不应再弹: %d", len(ps))
	}
	noteAssessment(t, store, task)
	l.evalClosure(ctx)
	ps := closurePrompts(t, store, task)
	if len(ps) != 2 || ps[1].AnchorKind != rings.ClosureAnchorContinue {
		t.Fatalf("同规则攒满应再次弹出(锚点=继续): %+v", ps)
	}
}

// TestClosureEvalSkippedWhenSettling 收尾中/已完成后不再评估(任务在
// 依序收场或已完成,收口提醒失去意义)。
func TestClosureEvalSkippedWhenSettling(t *testing.T) {
	store := openStore(t)
	ctx := context.Background()
	const task = "closure-skip"
	setClosureKeys(t, store, 1, 1)
	mkTaskAt(t, store, task, time.Now().Add(-10*time.Minute))
	noteAssessment(t, store, task)
	l := &Loop{TaskID: task, Store: store}
	l.mu.Lock()
	l.settling = true
	l.mu.Unlock()
	l.evalClosure(ctx)
	if ps := closurePrompts(t, store, task); len(ps) != 0 {
		t.Fatalf("收尾中不应弹: %d", len(ps))
	}
	l.mu.Lock()
	l.settling = false
	l.finished = true
	l.mu.Unlock()
	l.evalClosure(ctx)
	if ps := closurePrompts(t, store, task); len(ps) != 0 {
		t.Fatalf("已完成后不应弹: %d", len(ps))
	}
}

// TestClosurePromptFromCycle 挂接直证:真实研判轮(cycle 内拆解 →
// assessment 落账)逐轮推进计数,双条件满足时 prompt 由研判轮路径落账;
// 任务零控制面触点(生命周期停在 created,不打断的机器面)。
func TestClosurePromptFromCycle(t *testing.T) {
	store := openStore(t)
	ctx := context.Background()
	const task = "closure-cycle"
	setClosureKeys(t, store, 2, 1) // 阈值改小,更快触发(面板可配的同键)
	mkTaskAt(t, store, task, time.Now().Add(-2*time.Minute))

	model := newGatedScriptedModel(func(rr *recordedRequest) scriptedReply {
		if len(rr.ToolsOffered) == 0 {
			return scriptedReply{Text: `{"assessment":{"note":"态势无新变化"},"new_intents":[]}`}
		}
		return scriptedReply{Text: "{}"}
	})
	t.Cleanup(model.Close)
	model.release()
	prov, err := model.provider()
	if err != nil {
		t.Fatalf("构建 provider 失败: %v", err)
	}
	l := &Loop{TaskID: task, Store: store, Provider: prov}

	if l.cycle(ctx) {
		t.Fatal("目标未达成,cycle 不应报告任务完成")
	}
	if ps := closurePrompts(t, store, task); len(ps) != 0 {
		t.Fatalf("首轮后不应弹(轮数 1 < 2): %d", len(ps))
	}
	if l.cycle(ctx) {
		t.Fatal("目标未达成,cycle 不应报告任务完成")
	}
	ps := closurePrompts(t, store, task)
	if len(ps) != 1 {
		t.Fatalf("第二轮研判后应弹: %d", len(ps))
	}
	if ps[0].Rounds != 2 || ps[0].RoundsThreshold != 2 || ps[0].MinutesThreshold != 1 {
		t.Fatalf("快照应反映生效阈值: %+v", ps[0])
	}
	// 不打断:任务无任何收尾/终态动作,提醒只是账本事件。
	for _, a := range lifecycleActionsFor(t, store, task) {
		if a != "created" {
			t.Fatalf("收口提醒不应触碰任务生命周期: %v", a)
		}
	}
	// 第三轮:待决守卫。
	if l.cycle(ctx) {
		t.Fatal("目标未达成,cycle 不应报告任务完成")
	}
	if ps := closurePrompts(t, store, task); len(ps) != 1 {
		t.Fatalf("待决期间不应重复弹: %d", len(ps))
	}
	if got := len(model.decomposeRequests()); got < 3 {
		t.Fatalf("三轮研判各有拆解会话: %d", got)
	}
}

// TestClosureSeedAssetNotFinding 种子资产不算新发现(建任务表单随单
// 入账,锚点保持建任务时刻);手动补入(P4-05)照算清零。
func TestClosureSeedAssetNotFinding(t *testing.T) {
	store := openStore(t)
	ctx := context.Background()
	const task = "closure-seed"
	mkTaskAt(t, store, task, time.Now().Add(-40*time.Minute))
	seedAsset := func(id, source string) {
		t.Helper()
		detail := map[string]any{}
		if source != "" {
			detail["source"] = source
		}
		if _, err := store.Append(ctx, task, rings.Event{
			Kind: rings.EventNodeAdded, Actor: "creator",
			Payload: rings.NodeAdded{NodeID: id, NodeType: rings.NodeAsset,
				Title: id, Status: "active", AssetClass: rings.AssetHost, Detail: detail},
		}); err != nil {
			t.Fatalf("种资产 %s 失败: %v", id, err)
		}
	}
	noteAssessment(t, store, task)
	seedAsset("a-seed", rings.AssetSourceSeed)
	noteAssessment(t, store, task)
	st, err := ClosureOf(ctx, store, task)
	if err != nil {
		t.Fatalf("推导失败: %v", err)
	}
	if st.Rounds != 2 || st.AnchorKind != rings.ClosureAnchorCreated {
		t.Fatalf("种子资产不应动锚点: %+v", st)
	}
	seedAsset("a-manual", rings.AssetSourceManual)
	st, _ = ClosureOf(ctx, store, task)
	if st.Rounds != 0 || st.AnchorKind != rings.ClosureAnchorFinding {
		t.Fatalf("手动补入应清零重计: %+v", st)
	}
}

// TestClosureTaskConfigLayered 任务级配置三层推导(审核迭代 1):任务级
// > Agent 栏全局键 > 代码默认(20/50);开关只看任务级,关闭即整任务
// 不弹;config 快照式整体覆盖(单项留 0 = 回默认层)。
func TestClosureTaskConfigLayered(t *testing.T) {
	store := openStore(t)
	ctx := context.Background()
	const task = "closure-config"
	setClosureKeys(t, store, 7, 40) // 全局键层

	// ① 无任务级配置:生效 = 全局键。
	mkTaskAt(t, store, task, time.Now().Add(-50*time.Minute))
	noteAssessment(t, store, task)
	st, _ := ClosureOf(ctx, store, task)
	if en, r, m := ClosureEffective(ctx, store, st.TaskConfig); !en || r != 7 || m != 40 {
		t.Fatalf("无任务级配置应用全局键: %v %d %d", en, r, m)
	}
	// 轮数 1 < 7:不弹。
	l := &Loop{TaskID: task, Store: store}
	l.evalClosure(ctx)
	if ps := closurePrompts(t, store, task); len(ps) != 0 {
		t.Fatalf("轮数未达生效阈值不应弹: %d", len(ps))
	}

	// ② created 初始任务级配置(2/1)优先于全局键。
	const task2 = "closure-config2"
	if _, err := store.Append(ctx, task2, rings.Event{
		Kind: rings.EventTaskLifecycle, Actor: "manager", OccurredAt: time.Now().Add(-50 * time.Minute),
		Payload: rings.TaskLifecycle{Action: "created", Title: task2,
			Detail: map[string]any{"closure": map[string]any{"rounds": 2, "minutes": 1}}},
	}); err != nil {
		t.Fatalf("建任务失败: %v", err)
	}
	st2, _ := ClosureOf(ctx, store, task2)
	if en, r, m := ClosureEffective(ctx, store, st2.TaskConfig); !en || r != 2 || m != 1 {
		t.Fatalf("任务级应优先: %v %d %d", en, r, m)
	}
	// ③ 关闭开关:双条件满足也不弹。
	if _, err := store.Append(ctx, task2, rings.Event{
		Kind: rings.EventClosureRecord, Actor: "creator",
		Payload: rings.ClosureRecord{Type: rings.ClosureRecConfig, Enabled: new(bool)},
	}); err != nil {
		t.Fatalf("落 config 失败: %v", err)
	}
	noteAssessment(t, store, task2)
	noteAssessment(t, store, task2)
	l2 := &Loop{TaskID: task2, Store: store}
	l2.evalClosure(ctx)
	if ps := closurePrompts(t, store, task2); len(ps) != 0 {
		t.Fatalf("开关关闭不应弹: %d", len(ps))
	}
	st2, _ = ClosureOf(ctx, store, task2)
	if st2.TaskConfig.HasConfig != true || st2.TaskConfig.Enabled {
		t.Fatalf("config 应覆盖任务级配置: %+v", st2.TaskConfig)
	}

	// ④ 再打开并改小(1/1):弹(时间条件 50 分钟已过)。同时验证 config
	// 快照整体覆盖——rounds 只在新 config 里给,旧 created 的 2 被替换。
	on := true
	if _, err := store.Append(ctx, task2, rings.Event{
		Kind: rings.EventClosureRecord, Actor: "creator",
		Payload: rings.ClosureRecord{Type: rings.ClosureRecConfig, Enabled: &on, Rounds: 1, Minutes: 1},
	}); err != nil {
		t.Fatalf("落 config 失败: %v", err)
	}
	l2.evalClosure(ctx)
	ps := closurePrompts(t, store, task2)
	if len(ps) != 1 || ps[0].RoundsThreshold != 1 || ps[0].MinutesThreshold != 1 {
		t.Fatalf("改小后应按任务级阈值弹出: %+v", ps)
	}

	// ⑤ 全局键也未设时代码默认 20/50(审核迭代 1 造物主拍板)。
	const task3 = "closure-config3"
	mkTaskAt(t, store, task3, time.Now().Add(-time.Minute))
	st3, _ := ClosureOf(ctx, store, task3)
	_ = store.DeleteSetting(ctx, SettingKeyClosureRounds)
	_ = store.DeleteSetting(ctx, SettingKeyClosureMinutes)
	if en, r, m := ClosureEffective(ctx, store, st3.TaskConfig); !en || r != DefaultClosureRounds || m != DefaultClosureMinutes {
		t.Fatalf("无任务级无全局键应用代码默认: %v %d %d", en, r, m)
	}
	if DefaultClosureRounds != 20 || DefaultClosureMinutes != 50 {
		t.Fatalf("代码默认应为 20/50: %d/%d", DefaultClosureRounds, DefaultClosureMinutes)
	}
}

// TestClosureDismissParks 弹窗直接关闭(P4-23):dismiss 后待决保留、
// Parked=true(任务列表红点落点);新 prompt 重置搁置;继续/结束照常
// 解除待决;无待决时的历史 dismiss 不造幻影。
func TestClosureDismissParks(t *testing.T) {
	store := openStore(t)
	ctx := context.Background()
	const task = "closure-park"
	setClosureKeys(t, store, 1, 1)
	mkTaskAt(t, store, task, time.Now().Add(-10*time.Minute))
	noteAssessment(t, store, task)
	l := &Loop{TaskID: task, Store: store}
	l.evalClosure(ctx)
	if ps := closurePrompts(t, store, task); len(ps) != 1 {
		t.Fatalf("前置:应弹 1 次: %d", len(ps))
	}

	// 弹窗被直接关闭:待决保留、标搁置。
	if _, err := store.Append(ctx, task, rings.Event{
		Kind: rings.EventClosureRecord, Actor: "creator",
		Payload: rings.ClosureRecord{Type: rings.ClosureRecDismiss},
	}); err != nil {
		t.Fatalf("落 dismiss 失败: %v", err)
	}
	st, _ := ClosureOf(ctx, store, task)
	if st.Pending == nil || !st.Pending.Parked {
		t.Fatalf("dismiss 后应待决保留并标搁置: %+v", st.Pending)
	}

	// 搁置期间评估不重弹(待决守卫同一路径);再 dismiss 幂等。
	l.evalClosure(ctx)
	if ps := closurePrompts(t, store, task); len(ps) != 1 {
		t.Fatalf("搁置期间不应重弹: %d", len(ps))
	}

	// 新发现解决待决(搁置随之消失);时刻回拨以满足再弹的间隔条件。
	seedFindingAt(t, store, task, "f-p1", time.Now().Add(-2*time.Minute))
	st, _ = ClosureOf(ctx, store, task)
	if st.Pending != nil {
		t.Fatalf("新发现应解除待决: %+v", st.Pending)
	}

	// 再次攒满弹出新提醒:搁置态重置(新提醒重新弹窗)。
	noteAssessment(t, store, task)
	l.evalClosure(ctx)
	ps := closurePrompts(t, store, task)
	if len(ps) != 2 {
		t.Fatalf("应再次弹出: %d", len(ps))
	}
	st, _ = ClosureOf(ctx, store, task)
	if st.Pending == nil || st.Pending.Parked {
		t.Fatalf("新 prompt 应清搁置: %+v", st.Pending)
	}

	// 「继续」解除待决(搁置态随待决一并消失)。
	if _, err := store.Append(ctx, task, rings.Event{
		Kind: rings.EventClosureRecord, Actor: "creator",
		Payload: rings.ClosureRecord{Type: rings.ClosureRecDismiss},
	}); err != nil {
		t.Fatalf("落 dismiss 失败: %v", err)
	}
	if _, err := store.Append(ctx, task, rings.Event{
		Kind: rings.EventClosureRecord, Actor: "creator",
		Payload: rings.ClosureRecord{Type: rings.ClosureRecContinue},
	}); err != nil {
		t.Fatalf("落「继续」失败: %v", err)
	}
	st, _ = ClosureOf(ctx, store, task)
	if st.Pending != nil {
		t.Fatalf("「继续」应解除待决: %+v", st.Pending)
	}

	// 无待决时的 dismiss 被忽略(不造幻影提醒)。
	const task2 = "closure-park2"
	mkTaskAt(t, store, task2, time.Now())
	if _, err := store.Append(ctx, task2, rings.Event{
		Kind: rings.EventClosureRecord, Actor: "creator",
		Payload: rings.ClosureRecord{Type: rings.ClosureRecDismiss},
	}); err != nil {
		t.Fatalf("落 dismiss 失败: %v", err)
	}
	st2, _ := ClosureOf(ctx, store, task2)
	if st2.Pending != nil {
		t.Fatalf("无待决时 dismiss 不应造出提醒: %+v", st2.Pending)
	}
}

// fakeSettleCtl 收尾操控面的测试替身(记录两阶段调用)。
type fakeSettleCtl struct {
	marked   map[string]map[string]any
	finished map[string]map[string]any
}

func (f *fakeSettleCtl) MarkSettling(taskID string, detail map[string]any) error {
	if f.marked == nil {
		f.marked = map[string]map[string]any{}
	}
	f.marked[taskID] = detail
	return nil
}

func (f *fakeSettleCtl) FinishSettling(taskID string, achieved bool, detail map[string]any) error {
	if f.finished == nil {
		f.finished = map[string]map[string]any{}
	}
	d := map[string]any{"achieved": achieved}
	for k, v := range detail {
		d[k] = v
	}
	f.finished[taskID] = d
	return nil
}

// TestClosureEndSettles 「结束」键走优雅收尾:SettleNow 进入收尾
// (settled_by=closure_prompt,与整体超时区分)→ settle 流程定终态,
// 终态 detail 与黑匣子留痕均为收口口径;收尾中再评估不弹(守卫)。
func TestClosureEndSettles(t *testing.T) {
	store := openStore(t)
	ctx := context.Background()
	const task = "closure-end"
	setClosureKeys(t, store, 1, 1)
	mkTaskAt(t, store, task, time.Now().Add(-10*time.Minute))
	noteAssessment(t, store, task)

	fake := &fakeSettleCtl{}
	l := &Loop{TaskID: task, Store: store, SettleCtl: fake}
	l.SettleNow(ctx)

	if !l.isSettling() {
		t.Fatal("SettleNow 后应已进入收尾")
	}
	d := fake.marked[task]
	if d == nil || d["settled_by"] != rings.SettleByClosurePrompt {
		t.Fatalf("收尾进入应携带 settled_by=closure_prompt: %+v", d)
	}
	// 收尾中评估守卫(同一状态机路径)。
	l.evalClosure(ctx)
	if ps := closurePrompts(t, store, task); len(ps) != 0 {
		t.Fatalf("收尾中不应弹: %d", len(ps))
	}

	// settle 流程(Run 消费 settleKick 后的同一入口):无在跑单位 →
	// 终局判定(无目标 → 未全达成)→ 定终态 stopped。
	l.settle(ctx)
	fin := fake.finished[task]
	if fin == nil {
		t.Fatal("应已定终态")
	}
	if fin["achieved"] != false || fin["settled_by"] != rings.SettleByClosurePrompt {
		t.Fatalf("终态应为未全达成 + closure_prompt: %+v", fin)
	}
	if r, _ := fin["reason"].(string); !strings.Contains(r, "收口结束") {
		t.Fatalf("终态理由应为收口口径: %v", r)
	}
	var settling, settled rings.BlackboxRecord
	for _, b := range blackboxRecs(t, store, task) {
		switch b.Type {
		case rings.BlackboxTaskSettling:
			settling = b
		case rings.BlackboxTaskSettled:
			settled = b
		}
	}
	if settling.Type == "" {
		t.Fatal("黑匣子应留收尾进入痕迹")
	}
	if r, _ := settling.Detail["reason"].(string); !strings.Contains(r, "收口提醒选择结束") {
		t.Fatalf("黑匣子收尾留痕应为收口口径: %+v", settling)
	}
	if settled.Type == "" || settled.Detail["terminal"] != "stopped" {
		t.Fatalf("黑匣子终态留痕应为 stopped: %+v", settled)
	}
}
