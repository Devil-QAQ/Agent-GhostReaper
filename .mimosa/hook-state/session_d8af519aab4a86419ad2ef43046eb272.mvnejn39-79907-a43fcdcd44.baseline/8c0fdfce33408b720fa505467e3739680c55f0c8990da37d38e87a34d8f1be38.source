package failover

import (
	"context"
	"encoding/json"
	"fmt"
	"iter"
	"net/http"
	"sort"
	"strings"
	"sync"
	"time"

	"github.com/Autumn-27/norma/llm"

	"ghostreaper/internal/rings"
	"ghostreaper/internal/runlog"
)

// ---- Provider 熔断装饰器 · 备链版(P2-08c,第七章 §5 v2「主 + 备链」
// +「故障与恢复语义」④) ----
//
// Chain 实现 llm.Provider:主 + 备链路由与逐成员熔断,对会话循环透明——
// 切换发生在 Provider 层,同会话下一轮请求自动换腿,上下文全量携带、
// 对话不中断(引擎只看到一个 Provider)。
//
// 备链规则(第七章 §5 v2):
//   - 激活主用恒第 1 顺位(不按优先级);备为库内参与轮询的配置按
//     优先级排序(小者先,同优先级按名称稳定),主不可用时依序接替;
//   - 相同优先级的备轮流打头分摊额度(请求间轮转游标);
//   - 上下文窗口装不下当前请求的成员跳过;全部装不下时不跳过——让
//     端点如实报超长交引擎压缩,不用估计值拦死;
//   - 成员可标不参与(PollDisabled);
//   - 任务显式绑定模型的失败不悄悄换:绑定集(绑定主用 + 绑定备用)
//     耗尽即如实报错(防中途模型漂移),全局任务走备链自动接续;
//   - 逐成员熔断:连续瞬时失败达阈值(重试覆盖④)或额度耗尽即开冷却;
//     冷却梯度 60s→5min→30min(按累计开闸次数递进,探测成功归零);
//     冷却期满下一请求作探测(成功回切 closed,失败重开下一档)。
//
// 零交付安全重放(③):一个 token 都没交给调用方就失败的请求原样重放
// 整个请求——不重复输出、不产生工具副作用;已交付任何事件后失败只上抛
// (重放会重复半截输出)。不重试三类:额度耗尽→开闸换腿重放、上下文
// 超长→原样上抛交压缩、4xx 确定性拒绝→原样上抛。①SDK 建连重试与
// ②空响应重试由 Norma 内置 Provider 自带(成员级覆盖①②在构建
// Provider 时注入 llm.Config,见 BuildProvider)。
//
// 逐成员熔断状态持久化于键值表(failover.breakers,不含 key:配置内容
// 不进状态);进程重启后续冷却与梯度(装载时恢复);配置写路径的
// Reload 按惯例"切换即全新出发"清零熔断(06e 语义,面板经 /api/models
// 读同一状态)。

// 装配默认值(测试可缩小时长,不改语义)。
const (
	DefaultFailThreshold = 3                      // 连续瞬时失败软熔断阈值(成员级覆盖④可改)
	DefaultReplayLimit   = 2                      // 同一腿上零交付重放次数上限(覆盖③可改)
	DefaultBackoff       = 500 * time.Millisecond // 重放间隔(固定,简化退避)
)

// DefaultCooldownLadder 冷却梯度(第七章 §5 v2):首次开闸 60s,再开
// 5min,其后一律 30min;探测成功归零重走。测试可整梯缩小。
var DefaultCooldownLadder = []time.Duration{60 * time.Second, 5 * time.Minute, 30 * time.Minute}

// breakerState 单成员熔断状态(持久化形状;不含 key)。
type breakerState struct {
	Primary   string    `json:"primary,omitempty"` // 兼容字段(仅旧单熔断导入用)
	Backup    string    `json:"backup,omitempty"`
	State     string    `json:"state"` // closed|open
	OpenUntil time.Time `json:"open_until,omitempty"`
	Opens     int       `json:"opens"` // 累计开闸次数(梯度档位)
	Reason    string    `json:"reason,omitempty"`
	UpdatedAt time.Time `json:"updated_at"`
}

// MemberStatus 面板/测试读的链成员快照(备链顺序)。
type MemberStatus struct {
	Name      string    `json:"name"`
	Model     string    `json:"model"`
	Priority  int       `json:"priority"` // 0 = 主用(恒第 1);>0 = 备链优先级
	State     string    `json:"state"`    // closed|open|probing
	OpenUntil time.Time `json:"open_until,omitempty"`
	Opens     int       `json:"opens"`
	Reason    string    `json:"reason,omitempty"`
	UpdatedAt time.Time `json:"updated_at,omitempty"`
}

// 持久化键:逐成员熔断表(v2);failover.breaker 为 06e 单熔断遗留,
// 装载时导入后不再写。
const (
	keyBreakers      = "failover.breakers"
	keyLegacyBreaker = "failover.breaker"
)

// breakersState 持久化形状(仅存非 closed 成员,重启续冷却与梯度)。
type breakersState struct {
	Members   map[string]breakerState `json:"members"`
	UpdatedAt time.Time               `json:"updated_at"`
}

// EnvConfig 环境变量装配兜底(P1-02 惯例:运行时注入,零落盘)。模型库
// 未激活主用时,链以环境变量配置为主模型——面板模型库是配置的权威入口,
// 环境变量是进程级兜底。
type EnvConfig struct {
	Configured bool
	Format     string
	BaseURL    string
	APIKey     string
	Model      string
}

// EnvName 环境变量主模型在状态里的标记名。
const EnvName = "(env)"

// leg 一条可路由的腿:库配置或环境变量兜底,自带熔断状态。
type leg struct {
	name     string // 库内名或 EnvName
	model    string // token 记账模型 ID
	cfg      ModelConfig
	priority int // 备链优先级(主用/环境变量腿不参与分组,恒走 lead 位)
	prov     llm.Provider
	brk      breakerState
	consec   int // 连续瞬时失败(开闸归零)
}

// taskRoute 一个任务的腿集:lead 为绑定主用(显式绑定后失败不悄悄换,
// 备选只含绑定的备用);未绑定为 nil(随全局)。
type taskRoute struct {
	lead    *leg
	members []*leg
	strict  bool
}

// Chain 主 + 备链熔断装饰器。零值不可用,NewChain 构建;线程安全。
type Chain struct {
	Store *rings.Store
	Env   EnvConfig

	// 可调参数(零值取默认;测试缩小时长只影响时序不影响语义)。
	FailThreshold  int
	CooldownLadder []time.Duration // 梯度冷却;空取 DefaultCooldownLadder
	ReplayLimit    int
	Backoff        time.Duration

	Now   func() time.Time
	Sleep func(ctx context.Context, d time.Duration) bool // false=被取消

	// ProviderOpts 构建库配置 Provider 时的附加调优(演示/测试关闭 SDK
	// 层建连重试加速;生产留空走默认)。对环境变量腿同样生效。
	ProviderOpts func(*llm.Config)

	mu          sync.Mutex
	lead        *leg   // 主用腿(库激活或环境变量);无主配置时 nil
	members     []*leg // 备链成员(优先级升序,同优先级按名称)
	rr          map[int]int
	lastOKModel string
	taskCache   map[string]*taskRoute
}

// NewChain 构建链:按模型库/环境变量构建腿集 + 装载持久化熔断状态
// (进程重启续冷却)。store 为 nil 时链仍可用(仅环境变量腿,状态不
// 持久化——纯内存)。
func NewChain(store *rings.Store, env EnvConfig) *Chain {
	c := &Chain{Store: store, Env: env,
		FailThreshold: DefaultFailThreshold,
		ReplayLimit:   DefaultReplayLimit, Backoff: DefaultBackoff,
		Now:   time.Now,
		Sleep: sleepCtx,
	}
	c.mu.Lock()
	defer c.mu.Unlock()
	c.reloadLocked(context.Background(), true)
	return c
}

func sleepCtx(ctx context.Context, d time.Duration) bool {
	if d <= 0 {
		return ctx.Err() == nil
	}
	t := time.NewTimer(d)
	defer t.Stop()
	select {
	case <-ctx.Done():
		return false
	case <-t.C:
		return true
	}
}

// llmHTTPClient 按配置组装自定义 HTTP client(P4-03 ① + P4-10 ①):
// anthropic 格式挂用量输入侧补全(GLM 端点 message_start 零用量模式);
// opencode Go 网关(两种格式)再包会话头/UA 注入——openai 族格式仅注
// 头。返回 (nil, nil) = 无需自定义(走 llm 包默认 client)。设
// HTTPClient 后 llm 包忽略 Proxy,代理语义由自定义 client 自带。
func llmHTTPClient(cfg ModelConfig) (*http.Client, error) {
	if NormalizeFormat(cfg.Format) == "anthropic" {
		client, err := newAnthropicUsageClient(cfg.Proxy)
		if err != nil {
			return nil, err
		}
		if isOpenCodeGoURL(cfg.BaseURL) {
			client.Transport = newOpenCodeHeaderTransport(client.Transport)
		}
		return client, nil
	}
	if isOpenCodeGoURL(cfg.BaseURL) {
		return newOpenCodeGoClient(cfg.Proxy)
	}
	return nil, nil
}

// BuildProvider 由一条库配置构建 Norma Provider(P2-08c 起含 v2 全量
// 调优:代理/限速/思考/上限字段名/重试覆盖①②/关流式)。server 的测试
// 连接同用本函数——面板测的就是将要跑的。
func BuildProvider(cfg ModelConfig, opts func(*llm.Config)) (llm.Provider, error) {
	lc := llm.Config{
		Format: llm.Format(NormalizeFormat(cfg.Format)), BaseURL: cfg.BaseURL,
		APIKey: cfg.APIKey, Model: cfg.Model,
		Proxy:           cfg.Proxy,
		MaxTokensField:  cfg.MaxTokensField,
		ThinkingType:    cfg.Thinking,
		ReasoningEffort: cfg.ThinkingEffort,
	}
	if client, err := llmHTTPClient(cfg); err != nil {
		return nil, err
	} else if client != nil {
		lc.HTTPClient = client
	}
	if cfg.RatePerSecond > 0 || cfg.RatePerMinute > 0 {
		lc.RateLimit = &llm.RateLimit{PerSecond: cfg.RatePerSecond, PerMinute: cfg.RatePerMinute}
	}
	if cfg.RetryConnect != 0 { // ①建连重试:0=引擎默认 -1=关 >0=值
		lc.MaxRetries = cfg.RetryConnect
	}
	if cfg.RetryEmpty != 0 { // ②空响应重试:三态同上
		lc.EmptyResponseRetries = cfg.RetryEmpty
	}
	if opts != nil {
		opts(&lc)
	}
	prov, err := llm.NewProvider(lc)
	if err != nil {
		return nil, err
	}
	if cfg.StreamDisabled {
		prov = nonStreaming{prov} // 关流式:请求以非流式发出,事件面不变
	}
	if cfg.MaxTokens > 0 {
		prov = capTokensProvider{inner: prov, cap: cfg.MaxTokens} // 输出上限压到配置值
	}
	return prov, nil
}

// capTokensProvider 输出上限包装:请求未设或超上限时压到配置值(配置的
// max tokens 是该模型的输出上限,链路由与测试连接同语义)。
type capTokensProvider struct {
	inner llm.Provider
	cap   int
}

func (p capTokensProvider) clamp(req llm.CompletionRequest) llm.CompletionRequest {
	if p.cap > 0 && (req.MaxTokens <= 0 || req.MaxTokens > p.cap) {
		req.MaxTokens = p.cap
	}
	return req
}

func (p capTokensProvider) Complete(ctx context.Context, req llm.CompletionRequest) (llm.Message, string, llm.Usage, error) {
	return p.inner.Complete(ctx, p.clamp(req))
}

func (p capTokensProvider) Stream(ctx context.Context, req llm.CompletionRequest) iter.Seq2[llm.StreamEvent, error] {
	return p.inner.Stream(ctx, p.clamp(req))
}

func (c *Chain) buildProvider(cfg ModelConfig) (llm.Provider, error) {
	return BuildProvider(cfg, c.ProviderOpts)
}

// reloadLocked 重读模型库并构建腿集。restore=true 装载持久化熔断状态
// (进程启动续冷却);restore=false 清零熔断(配置写路径"切换即全新
// 出发",06e 语义)。旧单熔断态(failover.breaker)在无 v2 表时导入
// 主用腿。
func (c *Chain) reloadLocked(ctx context.Context, restore bool) {
	c.lead, c.members = nil, nil
	c.rr = map[int]int{}
	c.taskCache = map[string]*taskRoute{}
	primaryName := ""
	if c.Store != nil {
		if p, ok, _ := ActiveName(ctx, c.Store, RolePrimary); ok {
			primaryName = p
			if cfg, found, _ := ModelConfigByName(ctx, c.Store, p); found {
				if prov, err := c.buildProvider(cfg); err == nil {
					c.lead = &leg{name: cfg.Name, model: cfg.Model, cfg: cfg, prov: prov}
				}
			}
		}
	}
	if c.lead == nil && c.Env.Configured {
		cfg := ModelConfig{Name: EnvName, Format: c.Env.Format, BaseURL: c.Env.BaseURL,
			APIKey: c.Env.APIKey, Model: c.Env.Model}
		if prov, err := c.buildProvider(cfg); err == nil {
			c.lead = &leg{name: EnvName, model: c.Env.Model, cfg: cfg, prov: prov}
			primaryName = EnvName
		}
	}
	// 备链:库内参与轮询的其余配置(主用/环境变量腿除外)。
	if c.Store != nil {
		if cfgs, err := ListModelConfigs(ctx, c.Store); err == nil {
			rest := make([]ModelConfig, 0, len(cfgs))
			for _, cfg := range cfgs {
				if cfg.PollDisabled || cfg.Name == primaryName {
					continue
				}
				rest = append(rest, cfg)
			}
			sort.Slice(rest, func(i, j int) bool {
				pi, pj := rest[i].pollPriority(), rest[j].pollPriority()
				if pi != pj {
					return pi < pj
				}
				return rest[i].Name < rest[j].Name
			})
			for _, cfg := range rest {
				if prov, err := c.buildProvider(cfg); err == nil {
					c.members = append(c.members, &leg{name: cfg.Name, model: cfg.Model,
						cfg: cfg, priority: cfg.pollPriority(), prov: prov})
				}
			}
		}
	}
	for _, l := range c.allLegs() {
		l.brk = breakerState{State: "closed", UpdatedAt: c.Now()}
	}
	if restore && c.Store != nil {
		saved := map[string]breakerState{}
		if e, ok, _ := c.Store.Setting(ctx, keyBreakers); ok {
			var st breakersState
			if json.Unmarshal([]byte(e.Value), &st) == nil {
				saved = st.Members
			}
		} else if e, ok, _ := c.Store.Setting(ctx, keyLegacyBreaker); ok && c.lead != nil {
			var old breakerState
			if json.Unmarshal([]byte(e.Value), &old) == nil && old.State == "open" && old.Primary == c.lead.name {
				saved[c.lead.name] = breakerState{State: "open", OpenUntil: old.OpenUntil,
					Opens: 1, Reason: old.Reason, UpdatedAt: old.UpdatedAt}
			}
		}
		for _, l := range c.allLegs() {
			if b, ok := saved[l.name]; ok && b.State == "open" && l.brk.State == "closed" {
				l.brk = b
				l.brk.UpdatedAt = c.Now()
			}
		}
	}
}

// allLegs 主用在前、备链成员按序(面板快照与恢复遍历用)。
func (c *Chain) allLegs() []*leg {
	out := make([]*leg, 0, 1+len(c.members))
	if c.lead != nil {
		out = append(out, c.lead)
	}
	return append(out, c.members...)
}

// pollPriority 有效的备链优先级(0 视同 1)。
func (c ModelConfig) pollPriority() int {
	if c.PollPriority <= 0 {
		return 1
	}
	return c.PollPriority
}

// Reload 对外重载入口(配置写后调用):重建腿集,熔断清零(新配置
// 全新出发)并持久化清零态。
func (c *Chain) Reload(ctx context.Context) {
	c.mu.Lock()
	defer c.mu.Unlock()
	c.reloadLocked(ctx, false)
	c.persistLocked(ctx)
}

// persistLocked 熔断状态落键值表(by=failover)。失败不阻塞路由(持久化
// 是可见性义务,不是路由前提);store 为 nil 时跳过。仅存非 closed 成员。
func (c *Chain) persistLocked(ctx context.Context) {
	if c.Store == nil {
		return
	}
	st := breakersState{Members: map[string]breakerState{}, UpdatedAt: c.Now()}
	for _, l := range c.allLegs() {
		if l.brk.State == "open" {
			st.Members[l.name] = l.brk
		}
	}
	raw, err := json.Marshal(st)
	if err != nil {
		return
	}
	_ = c.Store.SetSetting(context.Background(), keyBreakers, string(raw), "failover")
}

// Ready 是否有可用腿(决定进程能否拉起执行器)。
func (c *Chain) Ready() bool {
	c.mu.Lock()
	defer c.mu.Unlock()
	return c.lead != nil || len(c.members) > 0
}

// AllCooling 全部腿是否都熔断冷却中(P4-27 ② 任务受阻收紧为任务级
// 普遍故障的链级实时信号:≥1 条腿存在且当前无任何可路由腿——冷却
// 期满待探测的腿不算冷却中,探测成功即恢复)。零腿(未配置)不在此
// 判定内——那是"未配置可用模型",由装配层如实呈现,不标受阻。
func (c *Chain) AllCooling() bool {
	c.mu.Lock()
	defer c.mu.Unlock()
	legs := c.allLegs()
	if len(legs) == 0 {
		return false
	}
	for _, l := range legs {
		if c.nowAvail(l) {
			return false
		}
	}
	return true
}

// Members 链成员快照(主用在前、备链按序;面板「主备轮询」抽屉数据
// 源);状态词 closed/open/probing(冷却期满待探测)。
func (c *Chain) Members() []MemberStatus {
	c.mu.Lock()
	defer c.mu.Unlock()
	out := make([]MemberStatus, 0, 1+len(c.members))
	for _, l := range c.allLegs() {
		out = append(out, MemberStatus{
			Name: l.name, Model: l.model, Priority: l.priority,
			State: c.stateWordOf(l), OpenUntil: l.brk.OpenUntil, Opens: l.brk.Opens,
			Reason: l.brk.Reason, UpdatedAt: l.brk.UpdatedAt,
		})
	}
	return out
}

func (c *Chain) stateWordOf(l *leg) string {
	if l.brk.State == "open" && !c.Now().Before(l.brk.OpenUntil) {
		return "probing"
	}
	return l.brk.State
}

// State 主用腿熔断态——06e 面板口径兼容(单熔断视图)。
func (c *Chain) State() breakerState {
	c.mu.Lock()
	defer c.mu.Unlock()
	if c.lead == nil && len(c.members) == 0 {
		return breakerState{State: "closed", UpdatedAt: c.Now()}
	}
	l := c.lead
	if l == nil {
		l = c.members[0] // 无主配置:首个备链成员当班
	}
	st := l.brk
	st.Primary = l.name
	if len(c.members) > 0 && c.members[0] != l {
		st.Backup = c.members[0].name
	}
	st.State = c.stateWordOf(l)
	return st
}

// ResetBreaker 立即恢复一个成员:熔断关闭、梯度归零(操作者裁决,全新
// 出发)。返回是否命中链内成员。
func (c *Chain) ResetBreaker(name string) bool {
	c.mu.Lock()
	defer c.mu.Unlock()
	for _, l := range c.allLegs() {
		if l.name == name {
			l.brk = breakerState{State: "closed", UpdatedAt: c.Now()}
			l.consec = 0
			c.persistLocked(context.Background())
			return true
		}
	}
	return false
}

// ActiveModel 最近一次成功请求所走模型的记账名(无成功记录时给当前
// 将走的路由;供 token 独立表按模型分账)。会话页每轮模型标签同源。
func (c *Chain) ActiveModel() string {
	c.mu.Lock()
	defer c.mu.Unlock()
	if c.lastOKModel != "" {
		return c.lastOKModel
	}
	route := c.routeLocked(context.Background(), llm.CompletionRequest{}, false)
	if route.current == nil {
		return ""
	}
	return route.currentModel
}

// taskKey 任务级路由的 ctx 键(执行器把 taskID 附进请求 ctx,链据此
// 解析任务绑定;无标记走全局)。
type taskKey struct{}

// WithTask 把任务标记进 ctx(虫群/主宰执行侧调用)。
func WithTask(ctx context.Context, taskID string) context.Context {
	if taskID == "" {
		return ctx
	}
	return context.WithValue(ctx, taskKey{}, taskID)
}

// TaskFromContext 读任务标记(空串=无标记)。
func TaskFromContext(ctx context.Context) string {
	if v, ok := ctx.Value(taskKey{}).(string); ok {
		return v
	}
	return ""
}

// routeOf 任务标记的腿集:显式绑定(绑定主用,可再绑备用)= 绑定集
// strict(失败不悄悄换);未绑定走全局(负缓存后不再查库)。结果进
// taskCache(配置写后 Reload 清空)。
func (c *Chain) routeOf(ctx context.Context) (lead *leg, members []*leg, strict bool) {
	id := TaskFromContext(ctx)
	if id == "" {
		return c.lead, c.members, false
	}
	if tr, ok := c.taskCache[id]; ok {
		if tr == nil {
			return c.lead, c.members, false
		}
		return tr.lead, tr.members, tr.strict
	}
	tr := &taskRoute{}
	if c.Store != nil {
		if name, ok := taskOverrideName(ctx, c.Store, id, RolePrimary); ok {
			tr.strict = true
			if l := c.legByName(name); l != nil {
				tr.lead = l
			}
			if name2, ok := taskOverrideName(ctx, c.Store, id, RoleBackup); ok {
				if l := c.legByName(name2); l != nil && l.name != name {
					tr.members = []*leg{l}
				}
			}
		}
	}
	if tr.lead == nil && !tr.strict {
		c.cacheTask(id, nil) // 无绑定:负缓存(仍走全局)
		return c.lead, c.members, false
	}
	if tr.lead == nil {
		// 绑定名已不在链内(配置被删):如实退化全局并在下轮 Reload 收敛。
		c.cacheTask(id, nil)
		return c.lead, c.members, false
	}
	c.cacheTask(id, tr)
	return tr.lead, tr.members, tr.strict
}

func (c *Chain) legByName(name string) *leg {
	for _, l := range c.allLegs() {
		if l.name == name {
			return l
		}
	}
	return nil
}

func (c *Chain) cacheTask(id string, tr *taskRoute) {
	if len(c.taskCache) > 256 {
		c.taskCache = map[string]*taskRoute{} // 上界防泄漏(配置切换即失效重建)
	}
	c.taskCache[id] = tr
}

// resolvedRoute 一次请求解析出的路由。
type resolvedRoute struct {
	current      *leg
	currentModel string
	probe        bool // 本请求是冷却期满的探测
	strict       bool // 任务显式绑定集
	noRoute      string
	windowNote   string // 因窗口跳过的成员说明(如实呈现)
}

func (c *Chain) nowAvail(l *leg) bool {
	return l.brk.State != "open" || !c.Now().Before(l.brk.OpenUntil)
}

// routeLocked 路由解析:主恒第 1(可用即走);备按优先级分组、组内
// 轮转;可用者全被窗口跳过时忽略窗口(端点如实报超长);全冷却时找
// 到期成员作探测,否则如实报错(最早恢复时刻)。consume=false 为观测
// 解析(routeChanged/ActiveModel 用)——不推进轮转游标,无副作用。
func (c *Chain) routeLocked(ctx context.Context, req llm.CompletionRequest, consume bool) resolvedRoute {
	lead, members, strict := c.routeOf(ctx)
	if lead == nil && len(members) == 0 {
		return resolvedRoute{noRoute: "未配置可用模型(模型库未激活主用,环境变量未注入)"}
	}
	est := estimateTokens(req)
	fits := func(l *leg) bool { return l.cfg.ContextWindow <= 0 || est <= l.cfg.ContextWindow }

	// 第一轮:可用且窗口装得下。
	if r, ok := c.pickLeg(lead, members, true, fits, consume); ok {
		r.strict = strict
		return r
	}
	// 第二轮:可用但全被窗口跳过 → 忽略窗口(端点报真实超长)。
	if r, ok := c.pickLeg(lead, members, false, fits, consume); ok {
		r.strict = strict
		r.windowNote = "成员上下文窗口均不足,按序直发(以端点超长报错为准)"
		return r
	}
	// 全冷却:找冷却期满的成员作探测(主用先探——冷却期满自动回切)。
	candidates := append([]*leg{}, lead)
	candidates = append(candidates, members...)
	for _, l := range candidates {
		if l != nil && l.brk.State == "open" && !c.Now().Before(l.brk.OpenUntil) {
			return resolvedRoute{current: l, currentModel: l.model, probe: true, strict: strict}
		}
	}
	// 无路可走:如实报错(最早恢复时刻 + 绑定语义)。
	earliest, at := "", time.Time{}
	for _, l := range candidates {
		if l == nil {
			continue
		}
		if l.brk.State == "open" && (at.IsZero() || l.brk.OpenUntil.Before(at)) {
			earliest, at = l.name, l.brk.OpenUntil
		}
	}
	if strict {
		return resolvedRoute{strict: true, noRoute: fmt.Sprintf(
			"任务绑定的模型全部熔断冷却中(不悄悄换模型;最早恢复 %s 至 %s)",
			earliest, at.Local().Format("15:04:05"))}
	}
	return resolvedRoute{noRoute: fmt.Sprintf(
		"全部模型熔断冷却中(最早恢复 %s 至 %s);可在 LLM 配置页立即恢复或等待冷却",
		earliest, at.Local().Format("15:04:05"))}
}

// pickLeg 挑一条腿:主用可用即走(恒第 1);否则备链按优先级分组,
// 组内轮转游标取一(consume=false 只读游标不推进)。withWindow=false
// 时忽略窗口过滤(全跳过的兜底轮)。
func (c *Chain) pickLeg(lead *leg, members []*leg, withWindow bool, fits func(*leg) bool, consume bool) (resolvedRoute, bool) {
	ok := func(l *leg) bool { return l != nil && c.nowAvail(l) && (!withWindow || fits(l)) }
	if ok(lead) {
		return resolvedRoute{current: lead, currentModel: lead.model, probe: lead.brk.State == "open"}, true
	}
	i := 0
	for i < len(members) {
		prio := members[i].priority
		group := []*leg{}
		for j := i; j < len(members) && members[j].priority == prio; j++ {
			if ok(members[j]) {
				group = append(group, members[j])
			}
		}
		if len(group) > 0 {
			cur := c.rr[prio] % len(group)
			if consume {
				c.rr[prio]++
			}
			return resolvedRoute{current: group[cur], currentModel: group[cur].model,
				probe: group[cur].brk.State == "open"}, true
		}
		for i < len(members) && members[i].priority == prio {
			i++
		}
	}
	return resolvedRoute{}, false
}

// estimateTokens 请求规模的粗估(token):ASCII 类 4 字符计 1,CJK 类
// 1 字符计 1(仅用于"上下文装不下跳过"的保守判定,不作记账)。
func estimateTokens(req llm.CompletionRequest) int {
	n := 0
	count := func(s string) {
		ascii := 0
		for _, r := range s {
			if r >= 0x2E80 {
				n++
			} else {
				ascii++
			}
		}
		n += (ascii + 3) / 4
	}
	for _, seg := range req.System {
		count(seg)
	}
	for _, m := range req.Messages {
		for _, b := range m.Content {
			count(b.Text)
			count(b.Thinking)
			count(string(b.Input))
		}
	}
	for _, t := range req.Tools {
		if raw, err := json.Marshal(t); err == nil {
			count(string(raw))
		}
	}
	return n + 64 // 系统性少量余量(块结构/角色标记)
}

// onSuccess 一次成功路由的收尾:探测成功即回切(梯度归零);成功即清
// 连续失败计数;记录记账模型。
func (c *Chain) onSuccess(l *leg) {
	l.consec = 0
	c.lastOKModel = l.model
	if l.brk.State != "closed" {
		l.brk = breakerState{State: "closed", UpdatedAt: c.Now()}
		c.persistLocked(context.Background())
	}
}

// onFailure 一次失败的路由收尾(逐成员):额度耗尽立即开闸;瞬时失败
// 连续达阈值软熔断(重试覆盖④:-1=熔断层关闭,>0=值);确定性拒绝/
// 超长/取消不计(换模型解决不了认证/参数/超长)。
func (c *Chain) onFailure(l *leg, cls ErrClass, err error) {
	if l == nil {
		return
	}
	brief := fmt.Sprintf("%s: %.160s", cls, strings.TrimSpace(err.Error()))
	switch cls {
	case ClassQuota:
		c.openLocked(l, "额度耗尽 "+brief)
	case ClassTransient:
		if l.cfg.RetryBreaker == -1 {
			return // 覆盖④=-1:熔断层关闭
		}
		l.consec++
		if l.consec >= c.failThresholdOf(l) {
			c.openLocked(l, fmt.Sprintf("连续瞬时失败 %d 次 %s", l.consec, brief))
		}
	}
}

// openLocked 开闸:梯度取档(累计开闸次数,顶档封顶),冷却期内不再
// 路由该成员。运行日志 WARN(P3-13b ③:熔断触发,第几次与原因)。
func (c *Chain) openLocked(l *leg, reason string) {
	l.brk.Opens++
	l.brk.State = "open"
	l.brk.OpenUntil = c.Now().Add(c.cooldownAt(l.brk.Opens))
	l.brk.Reason = reason
	l.brk.UpdatedAt = c.Now()
	l.consec = 0
	runlog.Warnf("模型熔断触发: 配置 %s 第 %d 次开闸,原因 %s,冷却至 %s",
		l.name, l.brk.Opens, reason, l.brk.OpenUntil.Format("15:04:05"))
	c.persistLocked(context.Background())
}

func (c *Chain) cooldownAt(opens int) time.Duration {
	ladder := c.CooldownLadder
	if len(ladder) == 0 {
		ladder = DefaultCooldownLadder
	}
	if opens < 1 {
		opens = 1
	}
	if opens > len(ladder) {
		opens = len(ladder)
	}
	return ladder[opens-1]
}

func (c *Chain) failThresholdOf(l *leg) int {
	if l.cfg.RetryBreaker > 0 {
		return l.cfg.RetryBreaker
	}
	if c.FailThreshold > 0 {
		return c.FailThreshold
	}
	return DefaultFailThreshold
}

// replayLimitOf 同一腿的零交付重放预算(重试覆盖③:0=链默认 -1=关
// >0=值)。
func (c *Chain) replayLimitOf(l *leg) int {
	if l != nil {
		switch {
		case l.cfg.RetryReplay == -1:
			return 0
		case l.cfg.RetryReplay > 0:
			return l.cfg.RetryReplay
		}
	}
	if c.ReplayLimit > 0 {
		return c.ReplayLimit
	}
	return DefaultReplayLimit
}

// Stream 路由 + 零交付安全重放。迭代器内惰性执行:已向调用方交付任何
// 事件后失败只上抛(重放会重复半截输出);零交付失败按类别处置(额度
// →开闸换腿重放;瞬时→重放并计连续失败;确定性/超长→上抛)。换腿后
// 重放预算重计(新腿自帷新生)。入口先做出站消息清洗(P4-27 ⑤:坏
// 消息根本不出站)。
func (c *Chain) Stream(ctx context.Context, req llm.CompletionRequest) iter.Seq2[llm.StreamEvent, error] {
	req = sanitizeReq(ctx, req)
	return func(yield func(llm.StreamEvent, error) bool) {
		replays := 0
		lastName := ""
		for {
			c.mu.Lock()
			route := c.routeLocked(ctx, req, true)
			c.mu.Unlock()
			if route.current == nil {
				yield(llm.StreamEvent{}, fmt.Errorf("failover: %s", route.noRoute))
				return
			}
			delivered := false
			var termErr error
			for ev, err := range route.current.prov.Stream(ctx, req) {
				if err != nil {
					termErr = err
					break
				}
				delivered = true
				if !yield(ev, nil) {
					return // 调用方停止消费:不当失败处理
				}
			}
			if termErr == nil {
				c.mu.Lock()
				c.onSuccess(route.current)
				c.mu.Unlock()
				return
			}
			cls := Classify(ctx, termErr)
			if cls != ClassCanceled {
				runlog.Warnf("模型调用失败: 配置 %s 模型 %s %s: %.200s",
					route.current.name, route.current.model, cls, strings.TrimSpace(termErr.Error()))
			}
			c.mu.Lock()
			c.onFailure(route.current, cls, termErr)
			switched := c.routeChanged(ctx, req, route)
			limit := c.replayLimitOf(route.current)
			c.mu.Unlock()
			if cls == ClassCanceled || delivered || cls == ClassDeterminant || cls == ClassTooLong {
				if cls != ClassCanceled {
					runlog.Errorf("LLM 调用失败(不再重试): 配置 %s 模型 %s: %v", route.current.name, route.current.model, termErr)
				}
				yield(llm.StreamEvent{}, termErr)
				return
			}
			if route.current.name != lastName {
				replays = 0
				lastName = route.current.name
			}
			if replays >= limit && !switched {
				runlog.Errorf("LLM 调用失败(重试耗尽): 配置 %s 模型 %s: %v", route.current.name, route.current.model, termErr)
				yield(llm.StreamEvent{}, termErr)
				return
			}
			if switched {
				replays = 0
			}
			replays++
			if !c.Sleep(ctx, c.backoffOf()) {
				yield(llm.StreamEvent{}, ctx.Err())
				return
			}
		}
	}
}

// routeChanged onFailure 是否已改变路由(开闸换腿)——当前请求立即换
// 腿重放(同会话透明接续:上下文全量在请求里)。观测解析,不推游标。
func (c *Chain) routeChanged(ctx context.Context, req llm.CompletionRequest, prev resolvedRoute) bool {
	now := c.routeLocked(ctx, req, false)
	if now.current == nil {
		return false
	}
	if prev.current == nil {
		return true
	}
	return now.current.name != prev.current.name
}

// Complete 非流式:整请求要么成功要么失败,失败一律可安全重放(无半截
// 交付),路由与计数语义同 Stream。入口先做出站消息清洗(P4-27 ⑤)。
func (c *Chain) Complete(ctx context.Context, req llm.CompletionRequest) (llm.Message, string, llm.Usage, error) {
	req = sanitizeReq(ctx, req)
	replays := 0
	lastName := ""
	for {
		c.mu.Lock()
		route := c.routeLocked(ctx, req, true)
		c.mu.Unlock()
		if route.current == nil {
			return llm.Message{}, "", llm.Usage{}, fmt.Errorf("failover: %s", route.noRoute)
		}
		msg, sr, usage, err := route.current.prov.Complete(ctx, req)
		if err == nil {
			c.mu.Lock()
			c.onSuccess(route.current)
			c.mu.Unlock()
			return msg, sr, usage, nil
		}
		cls := Classify(ctx, err)
		if cls != ClassCanceled {
			runlog.Warnf("模型调用失败: 配置 %s 模型 %s %s: %.200s",
				route.current.name, route.current.model, cls, strings.TrimSpace(err.Error()))
		}
		c.mu.Lock()
		c.onFailure(route.current, cls, err)
		switched := c.routeChanged(ctx, req, route)
		limit := c.replayLimitOf(route.current)
		c.mu.Unlock()
		if cls == ClassCanceled || cls == ClassDeterminant || cls == ClassTooLong {
			if cls != ClassCanceled {
				runlog.Errorf("LLM 调用失败(不再重试): 配置 %s 模型 %s: %v", route.current.name, route.current.model, err)
			}
			return llm.Message{}, "", llm.Usage{}, err
		}
		if route.current.name != lastName {
			replays = 0
			lastName = route.current.name
		}
		if replays >= limit && !switched {
			runlog.Errorf("LLM 调用失败(重试耗尽): 配置 %s 模型 %s: %v", route.current.name, route.current.model, err)
			return llm.Message{}, "", llm.Usage{}, err
		}
		if switched {
			replays = 0
		}
		replays++
		if !c.Sleep(ctx, c.backoffOf()) {
			return llm.Message{}, "", llm.Usage{}, ctx.Err()
		}
	}
}

func (c *Chain) backoffOf() time.Duration {
	if c.Backoff > 0 {
		return c.Backoff
	}
	return DefaultBackoff
}
