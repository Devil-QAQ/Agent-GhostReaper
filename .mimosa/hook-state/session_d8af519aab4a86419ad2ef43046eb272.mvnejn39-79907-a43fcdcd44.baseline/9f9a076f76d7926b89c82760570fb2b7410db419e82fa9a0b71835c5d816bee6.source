"use client";

import * as React from "react";
import { toast } from "sonner";

import { iconOf } from "@/components/icons";
import { ClosureDialog } from "@/components/closure-dialog";
import { CommandPalette } from "@/components/command-palette";
import { ThemeMenu } from "@/components/theme-menu";
import { SettingsPage } from "@/views/settings-page";
import { LLMPage } from "@/views/llm-page";
import { AgentPage } from "@/views/agent-page";
import { MCPPlaceholderPage, SKILLPlaceholderPage } from "@/views/placeholder-page";
import { ObservePage } from "@/views/observe-page";
import { ReportsPage } from "@/views/reports-page";
import { TaskSpace } from "@/views/task-space";
import { TasksPage } from "@/views/tasks-page";
import { TrafficPage } from "@/views/traffic-page";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import {
  TaskContextProvider,
  taskStatusBadge,
  usePolling,
  useTaskContext,
} from "@/lib/api";
import { LiveProvider, useLive } from "@/lib/live";
import {
  LEGACY_TASK_ROUTES,
  NAV_ITEMS,
  ROUTES,
  defaultTaskTab,
  isTaskTabEnabled,
} from "@/lib/nav";
import { cn } from "@/lib/utils";

// 平铺页面(点亮项);任务的一切面板在任务空间标签内(task-space.js
// 的 TAB_PAGE_OF),未点亮页面不挂载(未实现项隐藏而非缺失)。
const PAGE_OF = {
  tasks: TasksPage,
  // P2-12 一级·观测:Token 成本仪表盘 + 工具执行流水 + 吞吐指标
  //(全部只读既有记账)。
  observe: ObservePage,
  // P2-13 一级·报告:跨任务报告导出(格式矩阵;单任务展示在任务空间
  // 报告标签)。
  reports: ReportsPage,
  // P3-02 一级·流量:镜留痕列表/筛选/原文回放 + 证据绑定。
  traffic: TrafficPage,
  // P2-08c 侧栏一次调整:LLM配置(模型库 v2 + 备链)、Agent/MCP/SKILL
  // 四栏、设置改名系统设置;P2-08d 起 Agent 栏落地(牧者/主宰/虫群
  // 三组提示词与运行参数),MCP/SKILL 有意占位。
  llm: LLMPage,
  agent: AgentPage,
  mcp: MCPPlaceholderPage,
  skill: SKILLPlaceholderPage,
  settings: SettingsPage,
};

// AppShell:终态导航骨架(8.3 任务空间架构,P2-06g)——一级侧栏(全局)
// + 顶栏 + hash 路由内容区(平铺页 或 任务空间标签容器)。任务上下文
// 由任务空间路由携带注入;任务列表与审批待决计数在壳层取数一次,
// 各页面共享。P3-08 起壳层包实时推送连接:任务状态 / 审批待决 /
// 发现 / 受阻由推送驱动刷新(断线自动降级轮询,见 lib/live.js)。
export function AppShell() {
  return (
    <LiveProvider>
      <TaskContextProvider initial={readStoredTask()}>
        <Shell />
      </TaskContextProvider>
    </LiveProvider>
  );
}

function readStoredTask() {
  try {
    return localStorage.getItem("gr.currentTask") || null;
  } catch {
    return null;
  }
}

// hash 路由两种形态:平铺页(#/tasks、#/settings、临时入口)与任务
// 空间(#/task/<taskID>/<tab>,P2-09 起带 URL 定位参数 ?focus=<节点ID>
// ——跳转协议「在图中查看」的直达形态,平铺页不携带)。
function parseHash() {
  const raw = location.hash.replace(/^#\/?/, "");
  const [path, query] = raw.split("?");
  const parts = path.split("/").filter(Boolean);
  if (parts[0] === "task") {
    const params = new URLSearchParams(query || "");
    // focus = 跳转协议节点定位(?focus=<节点ID>);unit = 工作台执行流
    // 跳单位会话页的定位(?unit=<会话ID>,P2-10)。
    return {
      kind: "task",
      taskID: parts[1] || "",
      tab: parts[2] || "",
      focus: params.get("focus") || "",
      unit: params.get("unit") || "",
    };
  }
  if (ROUTES.includes(path)) return { kind: "flat", id: path };
  // P2-06g 前的平铺路由(四页已迁入任务空间),由壳层效应重定向。
  if (LEGACY_TASK_ROUTES.includes(path)) return { kind: "legacy", id: path };
  return { kind: "flat", id: "tasks" };
}

function useHashRoute() {
  // 初始值给静态默认(SSG 预渲染无 location),真实 hash 在客户端 effect 内对齐。
  const [route, setRoute] = React.useState({ kind: "flat", id: "tasks" });
  React.useEffect(() => {
    setRoute(parseHash());
    const on = () => setRoute(parseHash());
    window.addEventListener("hashchange", on);
    return () => window.removeEventListener("hashchange", on);
  }, []);
  return route;
}

function Shell() {
  const route = useHashRoute();
  const [collapsed, setCollapsed] = React.useState(false);
  // 命令面板开合(P3-10):⌘J / Ctrl+J 全局唤起,顶栏搜索按钮同入口。
  const [paletteOpen, setPaletteOpen] = React.useState(false);
  // 收口提醒重开目标(P4-23):任务行搁置红点点开 → 弹窗按该任务重开;
  // null = 自动态(未搁置的待决提醒到达即弹)。
  const [closureTarget, setClosureTarget] = React.useState(null);
  const { taskID } = useTaskContext();

  React.useEffect(() => {
    const onKey = (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "j") {
        e.preventDefault();
        setPaletteOpen((o) => !o);
      }
    };
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, []);

  // 路由规范化:旧平铺链接按当前任务重定向进任务空间;任务空间
  // URL 缺任务/标签未点亮时规范为可直达的形式。
  React.useEffect(() => {
    if (route.kind === "legacy") {
      location.hash = taskID ? `/task/${taskID}/${route.id}` : "/tasks";
    } else if (route.kind === "task" && (!route.taskID || !isTaskTabEnabled(route.tab))) {
      location.hash = route.taskID
        ? `/task/${route.taskID}/${defaultTaskTab()}`
        : "/tasks";
    }
  }, [route, taskID]);

  // 任务列表(P3-08 起实时推送驱动:任务状态 / 受阻徽标 / 目标进度
  // / 运行单位的变化由账本落账即推;推送未连接时按 2s 轮询降级)。
  const { data: tasks } = usePolling("/api/tasks", 2000, { live: ["tasks"] });
  const list = Array.isArray(tasks) ? tasks : [];
  const current = list.find((t) => t.id === taskID) || null;
  // 当前任务主状态徽标(P4-20:受阻优先于运行中,与任务列表行/工作台
  // 同口径,取态见 taskStatusBadge)。
  const currentBadge = taskStatusBadge(current);

  // 审批铃铛:当前任务待决计数(时效关键,点击跳 RoE 标签裁决)。
  const approvalsURL = taskID ? `/api/tasks/${taskID}/approvals` : null;
  const { data: approvalsBody } = usePolling(approvalsURL || "/api/healthz", 2000, {
    immediate: Boolean(approvalsURL),
    live: approvalsURL ? [`approval:${taskID}`] : null,
  });
  // 审批列表自 P2-06b 起为 {pending, records} 形状;旧数组形状兼容。
  const pendingList = approvalsURL
    ? Array.isArray(approvalsBody)
      ? approvalsBody
      : Array.isArray(approvalsBody?.pending)
        ? approvalsBody.pending
        : []
    : [];
  const pendingCount = pendingList.length;

  // 审批待决即时到达(P3-08):推送载荷一到即 toast,不待拉取。首见
  //(页面加载 / 切任务时的既有待决)只记不弹——播报只陈述新到达;
  // 数据面仅做静默打底(轮询数据在切任务瞬间可能是上一任务的,拿它
  // 做差分会误报,故不参与播报)。
  const { status: liveStatus, subscribe } = useLive();
  const seenPending = React.useRef(new Set());
  const primedPending = React.useRef(false);
  React.useEffect(() => {
    seenPending.current = new Set();
    primedPending.current = false;
  }, [taskID]);
  const notePending = (list) => {
    for (const a of list || []) {
      if (a?.id) seenPending.current.add(a.id);
    }
  };
  React.useEffect(() => {
    if (!taskID) return;
    return subscribe([`approval:${taskID}`], (detail) => {
      if (!detail || !Array.isArray(detail.pending)) return;
      if (!primedPending.current) {
        primedPending.current = true;
        notePending(detail.pending);
        return;
      }
      const fresh = detail.pending.filter((a) => a?.id && !seenPending.current.has(a.id));
      notePending(detail.pending);
      for (const a of fresh) {
        toast(`审批待决:${a.intent || a.tool_name}`, {
          description: a.tool_name || undefined,
          action: {
            label: "去审批",
            onClick: () => {
              location.hash = `/task/${taskID}/roe`;
            },
          },
        });
      }
    });
  }, [taskID, subscribe]);
  React.useEffect(() => {
    if (!primedPending.current && approvalsURL && Array.isArray(pendingList)) {
      primedPending.current = true;
      notePending(pendingList);
    }
  }, [pendingList, approvalsURL]);

  // 健康状态:年轮账本连通性(低频)。
  const { data: health } = usePolling("/api/healthz", 30000);
  const healthy = health?.status === "ok";

  // 面板版本(P4-26 ④):一次性读 /api/version——与运行日志头、诊断包
  // 同一来源(ldflags 注入);纯显示,排查混版本问题一眼可辨。
  const [version, setVersion] = React.useState("");
  React.useEffect(() => {
    fetch("/api/version")
      .then((r) => (r.ok ? r.json() : null))
      .then((b) => setVersion(b?.version || ""))
      .catch(() => {});
  }, []);

  const FlatPage = PAGE_OF[route.kind === "flat" ? route.id : "tasks"] || TasksPage;

  return (
    <div className="flex min-h-screen">
      {/* 侧栏(一级,全局功能;任务的一切面板在任务空间内)——8.9 质感:
          层次靠表面色阶不用描边、hover 所在层提亮、当前项克制强调、
          分组靠留白不靠分割线 */}
      <aside
        className={cn(
          "sticky top-0 flex h-screen shrink-0 flex-col bg-card transition-[width] duration-200",
          collapsed ? "w-14" : "w-56"
        )}
      >
        <div className="flex items-center gap-2 px-4 py-5">
          {!collapsed && (
            <span className="flex items-center gap-2 font-semibold tracking-tight">
              {/* 品牌徽标(P4-26 审核迭代 2):与 favicon 同源(public/icon.svg
                  镰刀徽标),替代原通用骷髅线形图标 */}
              {/* eslint-disable-next-line @next/next/no-img-element */}
              <img src="/icon.svg" alt="" className="size-5 rounded-[4px]" />
              GhostReaper
            </span>
          )}
          <Button
            variant="ghost"
            size="icon"
            className="ml-auto text-muted-foreground hover:text-foreground"
            title={collapsed ? "展开侧栏" : "收起侧栏"}
            onClick={() => setCollapsed((c) => !c)}
          >
            {React.createElement(iconOf(collapsed ? "panelLeftOpen" : "panelLeftClose"))}
          </Button>
        </div>

        {/* 一级导航:未实现项隐藏而非缺失(任务上下文由任务空间路由携带,
            P2-06g 审核迭代:侧栏任务选择器移除——从任务列表进入即选定) */}
        <nav className="flex-1 overflow-y-auto px-3 pb-4">
          <div className="flex flex-col gap-0.5">
            {NAV_ITEMS.filter((i) => i.enabled).map((item) => {
              const Icon = iconOf(item.icon);
              // 任务空间属任务域:进入后「任务」保持高亮。
              const active =
                route.kind === "task" ? item.id === "tasks" : route.id === item.id;
              // 受阻任务红点(P4-27 ④,与待审批红点同款形态):受阻
              //(待恢复)任务计数——只标需动作、处理即消;冻结/终态
              // 任务不标(冻结态不可操作,终态无事可做)。
              const blockedTasks =
                item.id === "tasks"
                  ? list.filter(
                      (t) =>
                        t.blocked &&
                        !["paused", "hibernated", "checkpointed", "stopped", "completed"].includes(t.status)
                    ).length
                  : 0;
              return (
                <button
                  key={item.id}
                  className={cn(
                    "relative flex items-center gap-3 rounded-md px-3 py-2 text-sm transition-colors duration-150 cursor-pointer",
                    active
                      ? "bg-primary/10 font-medium text-primary"
                      : "text-muted-foreground hover:bg-hover-lift hover:text-foreground"
                  )}
                  title={collapsed ? item.title : undefined}
                  onClick={() => (location.hash = `/${item.id}`)}
                >
                  {active && (
                    <span className="absolute top-1/2 left-0 h-4 w-0.5 -translate-y-1/2 rounded-full bg-primary" />
                  )}
                  <span className="relative shrink-0">
                    <Icon className="size-4" />
                    {/* 收起态文字隐藏,计数保留在图标角(信息不丢) */}
                    {collapsed && blockedTasks > 0 && (
                      <span
                        className="absolute -top-1.5 -right-2 flex h-4 min-w-4 items-center justify-center rounded-full bg-status-danger px-1 text-[10px] font-semibold text-primary-foreground"
                        title={`受阻任务 ${blockedTasks} 个`}
                      >
                        {blockedTasks}
                      </span>
                    )}
                  </span>
                  {!collapsed && <span className="truncate">{item.title}</span>}
                  {/* 受阻任务计数:紧跟词条之后(展开态) */}
                  {!collapsed && blockedTasks > 0 && (
                    <span
                      className="-ml-2 flex h-4 min-w-4 items-center justify-center rounded-full bg-status-danger px-1 text-[10px] font-semibold text-primary-foreground"
                      title={`受阻任务 ${blockedTasks} 个`}
                    >
                      {blockedTasks}
                    </span>
                  )}
                </button>
              );
            })}
          </div>
        </nav>

        {/* 健康状态(年轮账本连通性)与实时推送状态——留白分组,不用分割线 */}
        <div className="flex flex-col gap-1.5 px-5 pb-4 text-xs text-muted-foreground">
          <span className="flex items-center gap-2">
            <span
              className={cn(
                "size-2 rounded-full",
                healthy ? "bg-status-success" : "bg-status-danger"
              )}
            />
            {!collapsed && (healthy ? "年轮账本连通" : "后端未连通")}
          </span>
          {!collapsed && liveStatus !== "open" && (
            <span className="flex items-center gap-2">
              <span className="size-2 rounded-full bg-status-warning" />
              实时推送未连接
            </span>
          )}
          {/* 版本号(P4-26 ④):小号次级色纯显示,不可点——与运行日志头、
              诊断包同源(ldflags 注入) */}
          {!collapsed && version && <span title="GhostReaper">版本 {version}</span>}
          {/* 退出登录(P3-09 面板认证):吊销本次会话并回登录页 */}
          <button
            className="flex items-center gap-2 pt-1 text-left cursor-pointer hover:text-foreground transition-colors duration-150"
            title="退出登录"
            onClick={async () => {
              await fetch("/api/auth/logout", { method: "POST" }).catch(() => {});
              location.reload();
            }}
          >
            {React.createElement(iconOf("logOut"), { className: "size-3.5 shrink-0" })}
            {!collapsed && "退出登录"}
          </button>
        </div>
      </aside>

      {/* 主区 */}
      <div className="flex min-w-0 flex-1 flex-col">
        {/* 顶栏 */}
        <header className="sticky top-0 z-40 flex items-center gap-3 border-b bg-background/95 px-6 py-3 backdrop-blur">
          <div className="flex items-center gap-2 text-sm">
            {current ? (
              <>
                <span className="max-w-96 truncate font-medium" title={current.title || current.id}>
                  {current.title || current.id}
                </span>
                {/* 任务空间头部主状态(P4-20) */}
                <Badge variant={currentBadge.variant} title={currentBadge.title}>
                  {currentBadge.label}
                </Badge>
                {/* P2-14b①:顶栏不再常显任务 ID,悬停标题可见完整标识 */}
              </>
            ) : (
              <span className="text-muted-foreground">未选择任务</span>
            )}
          </div>
          <div className="ml-auto flex items-center gap-2">
            <button
              className="flex size-8 items-center justify-center rounded-md hover:bg-hover-lift cursor-pointer"
              title="命令面板 ⌘J"
              onClick={() => setPaletteOpen(true)}
            >
              {React.createElement(iconOf("command"))}
            </button>
            <ThemeMenu />
            <button
              className="relative flex size-8 items-center justify-center rounded-md hover:bg-hover-lift cursor-pointer"
              title={`待审批 · 当前任务待决 ${pendingCount} 条`}
              onClick={() => {
                location.hash = taskID ? `/task/${taskID}/roe` : "/tasks";
              }}
            >
              {React.createElement(iconOf("bell"))}
              {pendingCount > 0 && (
                <span className="absolute top-0.5 right-0.5 flex h-4 min-w-4 items-center justify-center rounded-full bg-status-danger px-1 text-[10px] font-semibold text-primary-foreground">
                  {pendingCount}
                </span>
              )}
            </button>
          </div>
        </header>

        <main
          className={cn(
            "mx-auto w-full flex-1 px-8 py-8",
            // 页面壳(8.4):平铺页内容区 1200px 居中,宽屏不满铺;任务
            // 空间整体铺满视口(每任务全家桶同宽)。
            route.kind === "task" ? "max-w-none" : "max-w-[1200px]"
          )}
        >
          {route.kind === "task" ? (
            <TaskSpace tasks={tasks} taskID={route.taskID} tab={route.tab} focus={route.focus} unit={route.unit} />
          ) : (
            <FlatPage tasks={list} currentTask={current} onReopenClosure={setClosureTarget} />
          )}
        </main>
      </div>

      {/* 命令面板(P3-10):全页面层,⌘J 唤起 */}
      <CommandPalette open={paletteOpen} onOpenChange={setPaletteOpen} tasks={list} />

      {/* 收口提醒弹窗(P4-18):全页面层,未搁置的待决提醒即弹;
          P4-23 可直接关闭(搁置落红点),任务行红点经 target 重开 */}
      <ClosureDialog tasks={list} target={closureTarget} onTargetDone={() => setClosureTarget(null)} />
    </div>
  );
}
