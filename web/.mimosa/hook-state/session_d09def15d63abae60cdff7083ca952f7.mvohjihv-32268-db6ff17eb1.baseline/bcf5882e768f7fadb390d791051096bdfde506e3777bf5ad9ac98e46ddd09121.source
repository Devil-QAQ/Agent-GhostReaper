import { PageHeader } from "@/components/page-header";
import { Badge } from "@/components/ui/badge";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import {
  Sheet,
  SheetContent,
  SheetDescription,
  SheetHeader,
  SheetTitle,
} from "@/components/ui/sheet";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import { usePolling } from "@/lib/api";
import { cn } from "@/lib/utils";

// 一级·观测(P2-12):Token 成本仪表盘(读 token 独立表)+ 工具执行流水
//(读账本工具调用记录)+ 两个吞吐指标(意图等待领取时长与队列深度,
//从事件流推导)——全部只读既有记账,零新增采集。主宰是否跟不上虫群,
//看吞吐两条线:等待持续拉长 / 深度持续堆高即瓶颈(收割减负挂账 P3)。

// ---- 词汇(术语门槛:记账归属 → 操作者语言)----

const AGENT_GROUP_LABELS = {
  swarm: "虫群",
  overmind: "主宰",
  shepherd: "牧者",
  interject: "插话",
};

function agentGroupLabel(g) {
  return AGENT_GROUP_LABELS[g] || g;
}

// 记账归属全称:swarm:u3 → 虫群单位 3(对照表:worker-N → 虫群单位 N)。
function agentLabel(agent) {
  if (agent.startsWith("swarm:")) {
    const n = agent.slice("swarm:".length).replace(/^u/, "");
    return "虫群单位 " + n;
  }
  if (agent.startsWith("interject:")) return "插话";
  return AGENT_GROUP_LABELS[agent] || agent;
}

function fmtNum(n) {
  return Number(n || 0).toLocaleString("en-US");
}

// 秒 → 人读时长(≤90s 用秒,更长用分秒;精确数字,不用"约")。
function fmtDur(seconds) {
  const s = Number(seconds || 0);
  if (s < 90) return `${Math.round(s * 10) / 10} 秒`;
  const m = Math.floor(s / 60);
  return `${m} 分 ${Math.round(s - m * 60)} 秒`;
}

function hhmm(t) {
  return String(t || "").slice(11, 16);
}

// ---- 词汇(P4-07 拦截命中:结局与走向 → 操作者语言)----

// 命中结局:拒绝线词与 P4-02 拒绝文案同源(lib/api.js DENY_SOURCE_LABELS)。
const HIT_OUTCOME_LABELS = {
  denied_hard: "内置拦截规则拒绝",
  denied_intent: "任务级拦截拒绝",
  approved: "批准执行",
  denied_panel: "审批拒绝终止",
  closeout: "收尾按拒绝结案",
  pending: "待决",
};

const HIT_OUTCOME_VARIANTS = {
  denied_hard: "danger",
  denied_intent: "warning",
  approved: "success",
  denied_panel: "danger",
  closeout: "warning",
  pending: "running",
};

// 被拒走向:换路成功继续 / 卡死 / 任务已停止 为主态,任务完成是最强
// 换路,继续中与已暂停为未定态(冻结中)。
const FOLLOW_LABELS = {
  rerouted_complete: "换路成功·任务完成",
  rerouted: "换路成功继续",
  task_stopped: "任务已停止",
  stalled: "卡死",
  active: "继续中",
  paused: "已暂停",
};

const FOLLOW_VARIANTS = {
  rerouted_complete: "success",
  rerouted: "success",
  task_stopped: "warning",
  stalled: "danger",
  active: "running",
  paused: "paused",
};

const RULE_LINE_LABELS = { hard_rule: "内置拦截规则", intent_rule: "意图拦截" };

// 走向分布摘要:换路成功合并计(完成与继续),只列非零项。
function followSummary(follows) {
  if (!follows) return "—";
  const rerouted = (follows.rerouted || 0) + (follows.rerouted_complete || 0);
  const parts = [
    ["换路成功", rerouted],
    ["继续中", follows.active || 0],
    ["已暂停", follows.paused || 0],
    ["卡死", follows.stalled || 0],
    ["任务停止", follows.task_stopped || 0],
  ].filter(([, n]) => n > 0);
  return parts.length > 0 ? parts.map(([w, n]) => `${w} ${n}`).join(" · ") : "—";
}

function ruleTitle(r) {
  return r?.group ? `${r.group} · ${r.name}` : r?.name || "";
}

// ---- 页面 ----

export function ObservePage({ tasks }) {
  const taskList = Array.isArray(tasks) ? tasks : [];

  // 吞吐口径的任务过滤(空 = 全部任务)。
  const [tpTask, setTpTask] = React.useState("");
  const tpURL = "/api/obs/throughput" + (tpTask ? `?task=${encodeURIComponent(tpTask)}` : "");
  const { data: tokenBody, error: tokenErr } = usePolling("/api/obs/tokens", 5000);
  const { data: tpBody, error: tpErr } = usePolling(tpURL, 5000);

  // 拦截命中口径的任务过滤(空 = 全部任务)。
  const [icTask, setIcTask] = React.useState("");
  const icURL = "/api/obs/intercepts" + (icTask ? `?task=${encodeURIComponent(icTask)}` : "");
  const { data: icBody, error: icErr } = usePolling(icURL, 5000);

  // 工具流水过滤(选项列表读全量口径,行读过滤口径)。
  const [fTask, setFTask] = React.useState("");
  const [fTool, setFTool] = React.useState("");
  const [fStatus, setFStatus] = React.useState("");
  const toolsURL =
    `/api/obs/tools?task=${encodeURIComponent(fTask)}` +
    `&tool=${encodeURIComponent(fTool)}&status=${fStatus}`;
  const { data: toolBody, error: toolErr } = usePolling(toolsURL, 5000);
  // 工具选项与计数随过滤口径变化,选项全量另存(首次拉取为准)。
  const [toolOptions, setToolOptions] = React.useState([]);
  React.useEffect(() => {
    const opts = toolBody?.tools;
    if (Array.isArray(opts) && !fTool && opts.length >= toolOptions.length) {
      setToolOptions(opts);
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [toolBody]);

  // 下钻抽屉。
  const [taskDrill, setTaskDrill] = React.useState(null); // {id,title}
  const [toolDrill, setToolDrill] = React.useState(null); // 流水行
  const [ruleDrill, setRuleDrill] = React.useState(null); // 拦截规则聚合
  const [hitDrill, setHitDrill] = React.useState(null); // 拒绝类命中(后续轨迹)

  return (
    <div className="flex flex-col gap-8">
      <PageHeader title="观测" subtitle="Token 成本 · 工具执行流水 · 吞吐指标 · 拦截命中" />

      {(tokenErr || tpErr || toolErr || icErr) && (
        <div className="rounded-md bg-status-danger-soft px-3 py-2 text-sm text-status-danger">
          读取失败:{tokenErr || tpErr || toolErr || icErr}
        </div>
      )}

      <TokenSection body={tokenBody} onDrillTask={setTaskDrill} />
      <ThroughputSection
        body={tpBody}
        taskList={taskList}
        tpTask={tpTask}
        onTask={setTpTask}
      />
      <ToolSection
        body={toolBody}
        options={toolOptions}
        taskList={taskList}
        fTask={fTask}
        fTool={fTool}
        fStatus={fStatus}
        onTask={setFTask}
        onTool={setFTool}
        onStatus={setFStatus}
        onDrill={setToolDrill}
      />

      <InterceptSection
        body={icBody}
        taskList={taskList}
        icTask={icTask}
        onTask={setIcTask}
        onDrillRule={setRuleDrill}
      />

      <TaskTokenDrawer drill={taskDrill} onClose={() => setTaskDrill(null)} />
      <ToolRowDrawer row={toolDrill} onClose={() => setToolDrill(null)} />
      <RuleHitsDrawer rule={ruleDrill} onClose={() => setRuleDrill(null)} onDrillHit={setHitDrill} />
      <TrajectoryDrawer hit={hitDrill} onClose={() => setHitDrill(null)} />
    </div>
  );
}

// ---- Token 成本仪表盘 ----

function TokenSection({ body, onDrillTask }) {
  const totals = body?.totals;
  const loading = !body;

  return (
    <section className="flex flex-col gap-4">
      <SectionTitle icon="coins" title="Token 成本" note="读逐次记账表,一行一次模型调用" />
      {loading ? (
        <div className="grid grid-cols-2 gap-4 md:grid-cols-5">
          {[0, 1, 2, 3, 4].map((i) => (
            <div key={i} className="skeleton h-24" />
          ))}
        </div>
      ) : !totals || totals.calls === 0 ? (
        <EmptyState
          icon="coins"
          title="尚无 token 记账"
          hint="任务运行后逐次模型调用在此汇总"
          action={{ label: "去任务列表", href: "/tasks" }}
        />
      ) : (
        <>
          <div className="grid grid-cols-2 gap-4 md:grid-cols-5">
            <KpiCard label="调用次数" value={fmtNum(totals.calls)} hint={`${totals.tasks} 个任务`} />
            <KpiCard label="输入 token" value={fmtNum(totals.input)} />
            <KpiCard label="输出 token" value={fmtNum(totals.output)} />
            <KpiCard label="缓存读取" value={fmtNum(totals.cache_read)} />
            <KpiCard label="缓存写入" value={fmtNum(totals.cache_write)} />
          </div>

          <Card>
            <CardHeader>
              <CardTitle>用量曲线</CardTitle>
              <CardDescription>
                按时间等宽分段 · 各段输入与输出合计与总量一致
              </CardDescription>
            </CardHeader>
            <CardContent>
              <TokenSeriesChart series={body.series} />
            </CardContent>
          </Card>

          <div className="grid gap-4 xl:grid-cols-3">
            <Card className="xl:col-span-2">
              <CardHeader>
                <CardTitle>按任务</CardTitle>
                <CardDescription>点击行看该任务明细</CardDescription>
              </CardHeader>
              <CardContent>
                <DimTable
                  rows={body.by_task}
                  nameRender={(r) => (
                    <span className="flex items-center gap-2">
                      <span className="truncate max-w-40" title={r.title || r.name}>{r.title || r.name}</span>
                      <span className="font-mono text-xs text-muted-foreground">{r.name}</span>
                    </span>
                  )}
                  extraHead="模型数"
                  extraCell={(r) => fmtNum(r.models)}
                  onRow={(r) => onDrillTask({ id: r.name, title: r.title })}
                />
              </CardContent>
            </Card>
            <div className="flex flex-col gap-4">
              <Card>
                <CardHeader>
                  <CardTitle>按模型</CardTitle>
                </CardHeader>
                <CardContent>
                  <DimTable rows={body.by_model} compact nameRender={(r) => <span className="font-mono text-xs">{r.name || "(未记模型)"}</span>} />
                </CardContent>
              </Card>
              <Card>
                <CardHeader>
                  <CardTitle>按角色</CardTitle>
                </CardHeader>
                <CardContent>
                  <DimTable
                    rows={body.by_agent}
                    compact
                    nameRender={(r) => agentGroupLabel(r.name)}
                  />
                </CardContent>
              </Card>
            </div>
          </div>
        </>
      )}
    </section>
  );
}

// DimTable 维度聚合表(按任务 / 模型 / 角色共用;compact 窄栏瘦身版
// 只留调用与输入输出,缓存明细在按任务表与任务抽屉)。
function DimTable({ rows, nameRender, extraHead, extraCell, onRow, compact }) {
  if (!Array.isArray(rows) || rows.length === 0) {
    return <div className="py-6 text-center text-xs text-muted-foreground">无记录</div>;
  }
  return (
    <Table>
      <TableHeader>
        <TableRow>
          <TableHead>{extraHead ? "任务" : "名称"}</TableHead>
          <TableHead className="text-right">调用</TableHead>
          <TableHead className="text-right">输入</TableHead>
          <TableHead className="text-right">输出</TableHead>
          {!compact && (
            <>
              <TableHead className="text-right">缓存读</TableHead>
              <TableHead className="text-right">缓存写</TableHead>
            </>
          )}
          {extraHead && <TableHead className="text-right">{extraHead}</TableHead>}
        </TableRow>
      </TableHeader>
      <TableBody>
        {rows.map((r) => (
          <TableRow
            key={r.name}
            className={cn(onRow && "cursor-pointer")}
            onClick={onRow ? () => onRow(r) : undefined}
          >
            <TableCell className="max-w-56">{nameRender(r)}</TableCell>
            <TableCell className="text-right tnum">{fmtNum(r.calls)}</TableCell>
            <TableCell className="text-right tnum">{fmtNum(r.input)}</TableCell>
            <TableCell className="text-right tnum">{fmtNum(r.output)}</TableCell>
            {!compact && (
              <>
                <TableCell className="text-right tnum text-muted-foreground">{fmtNum(r.cache_read)}</TableCell>
                <TableCell className="text-right tnum text-muted-foreground">{fmtNum(r.cache_write)}</TableCell>
              </>
            )}
            {extraHead && <TableCell className="text-right tnum">{extraCell(r)}</TableCell>}
          </TableRow>
        ))}
      </TableBody>
    </Table>
  );
}

// TaskTokenDrawer 点任务钻取:该任务的逐次明细(与全局聚合同源同真值)。
function TaskTokenDrawer({ drill, onClose }) {
  const { data: rows } = usePolling(
    drill ? `/api/tasks/${drill.id}/tokens` : "/api/healthz",
    5000,
    { immediate: Boolean(drill) }
  );
  const list = Array.isArray(rows) ? rows : [];
  const agg = React.useMemo(() => {
    const byModel = {};
    const byAgent = {};
    const t = { calls: 0, input: 0, output: 0, cache_read: 0, cache_write: 0 };
    for (const r of list) {
      t.calls++;
      t.input += r.input_tokens;
      t.output += r.output_tokens;
      t.cache_read += r.cache_read_tokens;
      t.cache_write += r.cache_write_tokens;
      const m = (byModel[r.model || "(未记模型)"] ||= { calls: 0, input: 0, output: 0 });
      m.calls++;
      m.input += r.input_tokens;
      m.output += r.output_tokens;
      const g = agentGroupLabel(groupOf(r.agent));
      const a = (byAgent[g] ||= { calls: 0, input: 0, output: 0 });
      a.calls++;
      a.input += r.input_tokens;
      a.output += r.output_tokens;
    }
    return { t, byModel, byAgent };
  }, [list]);

  return (
    <Sheet open={Boolean(drill)} onOpenChange={(o) => !o && onClose()}>
      <SheetContent className="max-w-2xl">
        <SheetHeader>
          <SheetTitle>{drill?.title || drill?.id} · token 明细</SheetTitle>
          <SheetDescription>
            {fmtNum(agg.t.calls)} 次调用 · 输入 {fmtNum(agg.t.input)} · 输出 {fmtNum(agg.t.output)} · 缓存读 {fmtNum(agg.t.cache_read)} · 缓存写 {fmtNum(agg.t.cache_write)}
          </SheetDescription>
        </SheetHeader>
        <div className="flex-1 overflow-y-auto px-4 pb-6">
          {list.length === 0 ? (
            <div className="py-10 text-center text-xs text-muted-foreground">该任务尚无记账</div>
          ) : (
            <div className="flex flex-col gap-5">
              <SubAggTable title="按模型" rows={agg.byModel} />
              <SubAggTable title="按角色" rows={agg.byAgent} nameKey />
              <div>
                <div className="mb-1 text-xs text-muted-foreground">逐次明细(最近 50 次)</div>
                <Table>
                  <TableHeader>
                    <TableRow>
                      <TableHead>时间</TableHead>
                      <TableHead>角色</TableHead>
                      <TableHead>模型</TableHead>
                      <TableHead>轮次</TableHead>
                      <TableHead className="text-right">输入</TableHead>
                      <TableHead className="text-right">输出</TableHead>
                    </TableRow>
                  </TableHeader>
                  <TableBody>
                    {list.slice(-50).reverse().map((r, i) => (
                      <TableRow key={i}>
                        <TableCell className="font-mono text-xs">{r.occurred_at?.slice(5)}</TableCell>
                        <TableCell>{agentLabel(r.agent)}</TableCell>
                        <TableCell className="font-mono text-xs">{r.model || "—"}</TableCell>
                        <TableCell className="tnum">{r.turn}</TableCell>
                        <TableCell className="text-right tnum">{fmtNum(r.input_tokens)}</TableCell>
                        <TableCell className="text-right tnum">{fmtNum(r.output_tokens)}</TableCell>
                      </TableRow>
                    ))}
                  </TableBody>
                </Table>
              </div>
            </div>
          )}
        </div>
      </SheetContent>
    </Sheet>
  );
}

function groupOf(agent) {
  if (agent.startsWith("swarm:") || agent === "swarm") return "swarm";
  if (agent.startsWith("interject:") || agent === "interject") return "interject";
  const i = agent.indexOf(":");
  return i > 0 ? agent.slice(0, i) : agent;
}

function SubAggTable({ title, rows, nameKey }) {
  const keys = Object.keys(rows || {});
  if (keys.length === 0) return null;
  return (
    <div>
      <div className="mb-1 text-xs text-muted-foreground">{title}</div>
      <Table>
        <TableHeader>
          <TableRow>
            <TableHead>名称</TableHead>
            <TableHead className="text-right">调用</TableHead>
            <TableHead className="text-right">输入</TableHead>
            <TableHead className="text-right">输出</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {keys.map((k) => (
            <TableRow key={k}>
              <TableCell>{nameKey ? k : <span className="font-mono text-xs">{k}</span>}</TableCell>
              <TableCell className="text-right tnum">{fmtNum(rows[k].calls)}</TableCell>
              <TableCell className="text-right tnum">{fmtNum(rows[k].input)}</TableCell>
              <TableCell className="text-right tnum">{fmtNum(rows[k].output)}</TableCell>
            </TableRow>
          ))}
        </TableBody>
      </Table>
    </div>
  );
}

// ---- 吞吐指标 ----

function ThroughputSection({ body, taskList, tpTask, onTask }) {
  const summary = body?.summary;
  const loading = !body;
  const hasData = summary && (summary.claims > 0 || summary.max_depth > 0);

  return (
    <section className="flex flex-col gap-4">
      <SectionTitle
        icon="activity"
        title="吞吐"
        note="意图从派发到被领取的等待时长 · 已派发未领取的意图数(队列深度)"
        right={
          <TaskSelect taskList={taskList} value={tpTask} onChange={onTask} />
        }
      />
      {loading ? (
        <div className="skeleton h-64" />
      ) : !hasData ? (
        <EmptyState
          icon="activity"
          title="尚无派发记录"
          hint="任务跑起来后,等待时长与队列深度在此出曲线"
          action={{ label: "去任务列表", href: "/tasks" }}
        />
      ) : (
        <div className="grid gap-4 xl:grid-cols-2">
          <Card>
            <CardHeader>
              <CardTitle>等待领取时长</CardTitle>
              <CardDescription>
                {summary.claims} 次领取 · 平均 {fmtDur(summary.avg_seconds)} · 最长 {fmtDur(summary.max_seconds)}
              </CardDescription>
            </CardHeader>
            <CardContent>
              <WaitsChart waits={body.waits} />
            </CardContent>
          </Card>
          <Card>
            <CardHeader>
              <CardTitle>队列深度</CardTitle>
              <CardDescription>
                峰值 {summary.max_depth} · 当前 {summary.waiting_now} 个意图等待领取
              </CardDescription>
            </CardHeader>
            <CardContent>
              <QueueChart queue={body.queue} />
            </CardContent>
          </Card>
        </div>
      )}
    </section>
  );
}

// ---- 工具执行流水 ----

function ToolSection({
  body,
  options,
  taskList,
  fTask,
  fTool,
  fStatus,
  onTask,
  onTool,
  onStatus,
  onDrill,
}) {
  const rows = Array.isArray(body?.rows) ? body.rows : [];
  const counts = body?.counts;
  const loading = !body;

  return (
    <section className="flex flex-col gap-4">
      <SectionTitle
        icon="terminal"
        title="工具执行流水"
        note={counts ? `共 ${fmtNum(counts.total)} 条 · 成功 ${fmtNum(counts.ok)} · 失败 ${fmtNum(counts.error)}${counts.shown < counts.total ? ` · 显示前 ${fmtNum(counts.shown)} 条` : ""}` : "每次工具调用的记录"}
        right={
          <div className="flex flex-wrap items-center gap-2">
            <TaskSelect taskList={taskList} value={fTask} onChange={onTask} />
            <Select value={fTool || "__all"} onValueChange={(v) => onTool(v === "__all" ? "" : v)}>
              <SelectTrigger className="w-40" title="工具">
                <SelectValue />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="__all">全部工具</SelectItem>
                {(options || []).map((t) => (
                  <SelectItem key={t.name} value={t.name}>
                    {t.name}({t.count}{t.errors > 0 ? `/${t.errors} 失败` : ""})
                  </SelectItem>
                ))}
              </SelectContent>
            </Select>
            <Select value={fStatus || "__all"} onValueChange={(v) => onStatus(v === "__all" ? "" : v)}>
              <SelectTrigger className="w-28" title="状态">
                <SelectValue />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="__all">全部状态</SelectItem>
                <SelectItem value="ok">成功</SelectItem>
                <SelectItem value="error">失败</SelectItem>
              </SelectContent>
            </Select>
          </div>
        }
      />
      {loading ? (
        <div className="skeleton h-64" />
      ) : rows.length === 0 ? (
        <EmptyState
          icon="terminal"
          title="无工具调用记录"
          hint="虫群与牧者执行工具后在此留痕"
          action={{ label: "去任务列表", href: "/tasks" }}
        />
      ) : (
        <Card className="py-0">
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>时间</TableHead>
                <TableHead>任务</TableHead>
                <TableHead>角色</TableHead>
                <TableHead>工具</TableHead>
                <TableHead className="max-w-72">参数</TableHead>
                <TableHead>结果</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {rows.map((r, i) => (
                <TableRow key={i} className="cursor-pointer" onClick={() => onDrill(r)}>
                  <TableCell className="font-mono text-xs text-muted-foreground">{r.at?.slice(5)}</TableCell>
                  <TableCell className="max-w-36 truncate" title={r.task_title || r.task_id}>{r.task_title || r.task_id}</TableCell>
                  <TableCell className="whitespace-nowrap">{agentLabel(r.agent)}</TableCell>
                  <TableCell className="font-mono text-xs">{r.tool}</TableCell>
                  <TableCell className="max-w-72 truncate font-mono text-xs text-muted-foreground" title={r.args}>
                    {briefArgs(r.args)}
                  </TableCell>
                  <TableCell>
                    <Badge variant={r.is_error ? "danger" : "success"}>
                      {r.is_error ? "失败" : "成功"}
                    </Badge>
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
        </Card>
      )}
    </section>
  );
}

function briefArgs(args) {
  if (!args) return "—";
  const s = String(args);
  return s.length > 80 ? s.slice(0, 80) + "…" : s;
}

// ToolRowDrawer 流水下钻:参数与结果全文 + 原始数据引用 + 步骤跳转。
function ToolRowDrawer({ row, onClose }) {
  return (
    <Sheet open={Boolean(row)} onOpenChange={(o) => !o && onClose()}>
      <SheetContent className="max-w-2xl">
        <SheetHeader>
          <SheetTitle className="flex items-center gap-2">
            <span className="font-mono">{row?.tool}</span>
            <Badge variant={row?.is_error ? "danger" : "success"}>
              {row?.is_error ? "失败" : "成功"}
            </Badge>
          </SheetTitle>
          <SheetDescription>
            {row?.at} · {row ? agentLabel(row.agent) : ""} · {row?.task_title || row?.task_id}
          </SheetDescription>
        </SheetHeader>
        {row && (
          <div className="flex flex-1 flex-col gap-4 overflow-y-auto px-4 pb-6">
            {row.step_id && (
              <div className="flex items-center gap-3 text-sm">
                <span className="text-muted-foreground">步骤</span>
                <span className="font-mono">{row.step_id}</span>
                <button
                  className="text-primary underline-offset-4 hover:underline cursor-pointer"
                  onClick={() =>
                    (location.hash = `/task/${row.task_id}/annulus?focus=${encodeURIComponent(row.step_id)}`)
                  }
                >
                  在图中查看 →
                </button>
              </div>
            )}
            {row.args && (
              <div>
                <div className="mb-1 text-xs text-muted-foreground">参数</div>
                <pre className="overflow-x-auto rounded-md bg-input-surface p-3 font-mono text-xs whitespace-pre-wrap break-all">
                  {row.args}
                </pre>
              </div>
            )}
            {row.result_head && (
              <div>
                <div className="mb-1 text-xs text-muted-foreground">结果</div>
                <pre className="max-h-72 overflow-y-auto rounded-md bg-input-surface p-3 font-mono text-xs whitespace-pre-wrap break-words">
                  {row.result_head}
                </pre>
              </div>
            )}
            {row.result_ref && (
              <div className="flex items-center gap-2 text-xs text-muted-foreground">
                <span title={row.result_ref}>原始数据</span>
              </div>
            )}
          </div>
        )}
      </SheetContent>
    </Sheet>
  );
}

// ---- 拦截命中统计(P4-07)----

// InterceptSection 每条拦截规则的命中次数与被拒走向,高频在前(误伤
// 模式数据化提前暴露);点行看该规则的近期命中,拒绝类命中可再下钻
// 后续轨迹。
function InterceptSection({ body, taskList, icTask, onTask, onDrillRule }) {
  const rules = Array.isArray(body?.rules) ? body.rules : [];
  const totals = body?.totals;
  const loading = !body;

  return (
    <section className="flex flex-col gap-4">
      <SectionTitle
        icon="shieldBan"
        title="拦截命中"
        note={
          totals
            ? `${totals.rules} 条规则 · 命中 ${fmtNum(totals.hits)} · 拒绝 ${fmtNum(totals.denied)} · 待决 ${fmtNum(totals.pending)}`
            : "每条拦截规则的命中次数与被拒单位走向"
        }
        right={<TaskSelect taskList={taskList} value={icTask} onChange={onTask} />}
      />
      {loading ? (
        <div className="skeleton h-64" />
      ) : rules.length === 0 ? (
        <EmptyState
          icon="shieldBan"
          title="尚无拦截命中"
          hint="虫群调用被拦截规则拒绝或提交审批后在此汇总"
          action={{ label: "去任务列表", href: "/tasks" }}
        />
      ) : (
        <Card className="py-0">
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>规则</TableHead>
                <TableHead className="text-right">命中</TableHead>
                <TableHead className="text-right">拒绝</TableHead>
                <TableHead className="text-right" title="批准 · 面板拒绝 · 待决">需批准</TableHead>
                <TableHead>被拒走向</TableHead>
                <TableHead>最近命中</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {rules.map((r) => (
                <TableRow
                  key={`${r.line}:${r.group || ""}:${r.name}`}
                  className="cursor-pointer"
                  onClick={() => onDrillRule(r)}
                >
                  <TableCell className="max-w-72">
                    <div className="flex items-center gap-2">
                      <Badge variant="outline">{RULE_LINE_LABELS[r.line] || r.line}</Badge>
                      <span className="truncate" title={ruleTitle(r)}>{ruleTitle(r)}</span>
                    </div>
                  </TableCell>
                  <TableCell className="text-right tnum">{fmtNum(r.hits)}</TableCell>
                  <TableCell className="text-right tnum">{fmtNum(r.denied)}</TableCell>
                  <TableCell
                    className="text-right tnum"
                    title={r.gate > 0 ? `批准 ${fmtNum(r.approved)} · 面板拒绝 ${fmtNum(r.panel_denied)} · 待决 ${fmtNum(r.pending)}` : undefined}
                  >
                    {r.gate > 0 ? fmtNum(r.gate) : "—"}
                  </TableCell>
                  <TableCell className="max-w-64">
                    <span className="text-xs text-muted-foreground">{followSummary(r.follows)}</span>
                  </TableCell>
                  <TableCell className="font-mono text-xs text-muted-foreground">
                    {r.last_at?.slice(5)}
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
        </Card>
      )}
    </section>
  );
}

// RuleHitsDrawer 规则下钻:近期命中记录(命令原文全文可查);拒绝类
// 命中行带走向,点行再下钻后续轨迹。
function RuleHitsDrawer({ rule, onClose, onDrillHit }) {
  const gateNote =
    rule?.gate > 0
      ? ` · 需批准 ${fmtNum(rule.gate)}(批准 ${fmtNum(rule.approved)} · 面板拒绝 ${fmtNum(rule.panel_denied)} · 待决 ${fmtNum(rule.pending)})`
      : "";
  return (
    <Sheet open={Boolean(rule)} onOpenChange={(o) => !o && onClose()}>
      <SheetContent className="max-w-3xl">
        <SheetHeader>
          <SheetTitle className="flex items-center gap-2">
            <Badge variant="outline">{RULE_LINE_LABELS[rule?.line] || ""}</Badge>
            <span className="truncate" title={ruleTitle(rule)}>{ruleTitle(rule)}</span>
          </SheetTitle>
          <SheetDescription>
            {rule ? `命中 ${fmtNum(rule.hits)} · 拒绝 ${fmtNum(rule.denied)}${gateNote} · 走向 ${followSummary(rule.follows)}` : ""}
          </SheetDescription>
        </SheetHeader>
        <div className="flex-1 overflow-y-auto px-4 pb-6">
          <div className="mb-1 text-xs text-muted-foreground">近期命中(新到旧,至多 10 条;点拒绝类行看后续轨迹)</div>
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>时间</TableHead>
                <TableHead>任务</TableHead>
                <TableHead>单位</TableHead>
                <TableHead>工具</TableHead>
                <TableHead className="max-w-56">命令原文</TableHead>
                <TableHead>结局</TableHead>
                <TableHead>走向</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {(rule?.recent || []).map((h, i) => (
                <TableRow
                  key={i}
                  className={cn(h.follow ? "cursor-pointer" : "")}
                  onClick={
                    h.follow
                      ? (e) => {
                          // 命令原文按钮的点击不触发轨迹下钻(避免一次点击双开)
                          if (e.target.closest("button")) return;
                          onDrillHit(h);
                        }
                      : undefined
                  }
                >
                  <TableCell className="font-mono text-xs text-muted-foreground">{h.at?.slice(5)}</TableCell>
                  <TableCell className="max-w-32 truncate" title={h.task_title || h.task_id}>
                    {h.task_title || h.task_id}
                  </TableCell>
                  <TableCell className="font-mono text-xs">{h.unit_id || "—"}</TableCell>
                  <TableCell className="font-mono text-xs">{h.tool}</TableCell>
                  <TableCell className="max-w-56">
                    <LongText text={h.args} max={48} mono variant="dialog" label="命令原文" />
                  </TableCell>
                  <TableCell>
                    <Badge variant={HIT_OUTCOME_VARIANTS[h.outcome] || "outline"}>
                      {HIT_OUTCOME_LABELS[h.outcome] || h.outcome}
                    </Badge>
                  </TableCell>
                  <TableCell>
                    {h.follow ? (
                      <Badge variant={FOLLOW_VARIANTS[h.follow.outcome] || "outline"}>
                        {FOLLOW_LABELS[h.follow.outcome]}
                      </Badge>
                    ) : (
                      <span className="text-xs text-muted-foreground">—</span>
                    )}
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
        </div>
      </SheetContent>
    </Sheet>
  );
}

// TrajectoryDrawer 后续轨迹下钻:被拒那一刻起的任务时间线(换路派发 /
// 其余步骤收好 / 任务收场)与被拒单位自身的续行。
function TrajectoryDrawer({ hit, onClose }) {
  const f = hit?.follow;
  const summary = React.useMemo(() => {
    if (!f) return "";
    const parts = [];
    if (f.task_now) parts.push(`任务当前:${f.task_now}`);
    if (f.steps_done > 0) parts.push(`被拒后 ${f.steps_done} 个新步骤完成`);
    if (f.unit_calls > 0) parts.push(`单位继续 ${f.unit_calls} 次调用`);
    if (f.unit_end) parts.push(`单位收场:${f.unit_end}`);
    return parts.join(" · ");
  }, [f]);

  return (
    <Sheet open={Boolean(hit)} onOpenChange={(o) => !o && onClose()}>
      <SheetContent className="max-w-xl">
        <SheetHeader>
          <SheetTitle className="flex items-center gap-2">
            <span>后续轨迹</span>
            {f && (
              <Badge variant={FOLLOW_VARIANTS[f.outcome] || "outline"}>
                {FOLLOW_LABELS[f.outcome]}
              </Badge>
            )}
          </SheetTitle>
          <SheetDescription>
            {hit ? `${hit.at} · ${agentLabel("swarm:" + (hit.unit_id || ""))} · ${hit.task_title || hit.task_id}` : ""}
          </SheetDescription>
        </SheetHeader>
        {hit && f && (
          <div className="flex flex-1 flex-col gap-4 overflow-y-auto px-4 pb-6">
            {summary && <div className="text-sm">{summary}</div>}
            {hit.args && (
              <div>
                <div className="mb-1 text-xs text-muted-foreground">命中命令</div>
                <pre className="overflow-x-auto rounded-md bg-input-surface p-3 font-mono text-xs whitespace-pre-wrap break-all">
                  {hit.args}
                </pre>
                {hit.reason && <div className="mt-2 text-xs text-muted-foreground">{hit.reason}</div>}
              </div>
            )}
            <div>
              <div className="mb-1 text-xs text-muted-foreground">
                被拒后时间线{f.truncated ? "(前 60 条)" : ""}
              </div>
              <div className="flex flex-col gap-1.5">
                {(f.events || []).map((e, i) => (
                  <div key={i} className="flex items-baseline gap-3 text-sm">
                    <span className="w-14 shrink-0 font-mono text-xs text-muted-foreground">
                      {e.at?.slice(11)}
                    </span>
                    <span>{e.text}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}
      </SheetContent>
    </Sheet>
  );
}

// ---- 通用小件 ----

function SectionTitle({ icon, title, note, right }) {
  const Icon = iconOf(icon);
  return (
    <div className="flex flex-wrap items-center justify-between gap-3">
      <div className="flex items-center gap-3">
        <Icon className="size-4 text-muted-foreground" />
        <h2 className="text-lg font-semibold">{title}</h2>
        {note && <span className="text-xs text-muted-foreground">{note}</span>}
      </div>
      {right}
    </div>
  );
}

// TaskSelect 任务过滤(空值 = 全部任务)。
function TaskSelect({ taskList, value, onChange }) {
  return (
    <Select value={value || "__all"} onValueChange={(v) => onChange(v === "__all" ? "" : v)}>
      <SelectTrigger className="w-44" title="任务">
        <SelectValue />
      </SelectTrigger>
      <SelectContent>
        <SelectItem value="__all">全部任务</SelectItem>
        {taskList.map((t) => (
          <SelectItem key={t.id} value={t.id}>
            {t.title || t.id}
          </SelectItem>
        ))}
      </SelectContent>
    </Select>
  );
}

// ---- 图(页内 SVG,色值全走 8.4 token,不自建组件体系)----

const CHART_W = 800;
const CHART_H = 180;
const CHART_PAD = { l: 8, r: 8, t: 14, b: 20 };

// 图表取色(读当前主题 token;SSR/取值失败回退 = 暗色 token 值,
// 与 globals.css 同源)
function chartColors() {
  if (typeof window === "undefined") return { primary: "#8fae94", muted: "#9b9a94", line: "#232327" };
  const cs = getComputedStyle(document.body);
  return {
    primary: cs.getPropertyValue("--primary").trim() || "#8fae94",
    muted: cs.getPropertyValue("--muted-foreground").trim() || "#9b9a94",
    line: cs.getPropertyValue("--border").trim() || "#232327",
  };
}

// ChartFrame 图公共框:网格线 + 首末时间标注 + 右上角峰值标注。
function ChartFrame({ x0, x1, yMax, children, unit }) {
  const c = chartColors();
  const iw = CHART_W - CHART_PAD.l - CHART_PAD.r;
  const ih = CHART_H - CHART_PAD.t - CHART_PAD.b;
  const gridYs = [0.25, 0.5, 0.75, 1];
  return (
    <svg viewBox={`0 0 ${CHART_W} ${CHART_H}`} className="w-full" role="img">
      {gridYs.map((g) => (
        <line
          key={g}
          x1={CHART_PAD.l}
          x2={CHART_W - CHART_PAD.r}
          y1={CHART_PAD.t + ih * (1 - g)}
          y2={CHART_PAD.t + ih * (1 - g)}
          stroke={c.line}
          strokeWidth="1"
          opacity="0.6"
        />
      ))}
      {children}
      <text x={CHART_PAD.l} y={CHART_H - 6} fontSize="11" fill={c.muted}>
        {hhmm(x0)}
      </text>
      <text x={CHART_W - CHART_PAD.r} y={CHART_H - 6} fontSize="11" fill={c.muted} textAnchor="end">
        {hhmm(x1)}
      </text>
      <text x={CHART_W - CHART_PAD.r} y={CHART_PAD.t - 3} fontSize="11" fill={c.muted} textAnchor="end">
        {unit}
      </text>
    </svg>
  );
}

// TokenSeriesChart 用量柱状(输入 + 输出堆叠,色 = 品牌蓝 / 中性灰)。
function TokenSeriesChart({ series }) {
  const list = (series || []).filter((b) => b.input + b.output > 0);
  if (list.length === 0) return <div className="py-8 text-center text-xs text-muted-foreground">全区间零用量</div>;
  const c = chartColors();
  const iw = CHART_W - CHART_PAD.l - CHART_PAD.r;
  const ih = CHART_H - CHART_PAD.t - CHART_PAD.b;
  const x0 = series[0]?.t;
  const x1 = series[series.length - 1]?.t;
  let max = 0;
  for (const b of series) max = Math.max(max, b.input + b.output);
  const n = series.length;
  const bw = Math.max(1, iw / n - (n > 1 ? 1.5 : 0));
  return (
    <div className="flex flex-col gap-2">
      <ChartFrame x0={x0} x1={x1} unit={`峰 ${fmtNum(max)} token/段`}>
        {series.map((b, i) => {
          const x = CHART_PAD.l + (i * iw) / n;
          const hIn = (b.input / max) * ih;
          const hOut = (b.output / max) * ih;
          const yIn = CHART_PAD.t + ih - hIn;
          return (
            <g key={i}>
              {b.input > 0 && (
                <rect x={x} y={yIn} width={bw} height={hIn} fill={c.primary} opacity="0.85" />
              )}
              {b.output > 0 && (
                <rect x={x} y={yIn - hOut} width={bw} height={hOut} fill={c.muted} opacity="0.9" />
              )}
            </g>
          );
        })}
      </ChartFrame>
      <div className="flex items-center gap-4 text-xs text-muted-foreground">
        <Legend color={c.primary} label="输入" />
        <Legend color={c.muted} label="输出" />
      </div>
    </div>
  );
}

function Legend({ color, label }) {
  return (
    <span className="flex items-center gap-2">
      <span className="inline-block size-2 rounded-[2px]" style={{ background: color }} />
      {label}
    </span>
  );
}

// WaitsChart 等待领取时长散点(x = 领取时刻,y = 等待秒)。
function WaitsChart({ waits }) {
  const list = waits || [];
  if (list.length === 0) {
    return <div className="py-8 text-center text-xs text-muted-foreground">尚无领取</div>;
  }
  const c = chartColors();
  const iw = CHART_W - CHART_PAD.l - CHART_PAD.r;
  const ih = CHART_H - CHART_PAD.t - CHART_PAD.b;
  const t0 = list[0].at;
  const t1 = list[list.length - 1].at;
  const max = Math.max(...list.map((w) => w.seconds), 1);
  const timeOf = (s) => new Date(s.replace(" ", "T")).getTime();
  const t0ms = timeOf(t0);
  const span = Math.max(timeOf(t1) - t0ms, 1);
  const xOf = (at) => CHART_PAD.l + ((timeOf(at) - t0ms) / span) * iw;
  const yOf = (s) => CHART_PAD.t + ih - (s / max) * ih;
  return (
    <ChartFrame x0={t0} x1={t1} unit={`峰 ${fmtDur(max)}`}>
      {list.map((w, i) => (
        <circle key={i} cx={xOf(w.at)} cy={yOf(w.seconds)} r="3.5" fill={c.primary} opacity="0.8">
          <title>{`${w.at} ${w.task_id} ${w.step_id} 等待 ${fmtDur(w.seconds)}`}</title>
        </circle>
      ))}
    </ChartFrame>
  );
}

// QueueChart 队列深度阶跃线(区域淡填充)。
function QueueChart({ queue }) {
  const list = (queue || []).filter((p) => p.depth > 0);
  if (list.length === 0) {
    return <div className="py-8 text-center text-xs text-muted-foreground">队列从未有积压</div>;
  }
  const all = queue || [];
  const c = chartColors();
  const iw = CHART_W - CHART_PAD.l - CHART_PAD.r;
  const ih = CHART_H - CHART_PAD.t - CHART_PAD.b;
  const t0 = all[0]?.t;
  const t1 = all[all.length - 1]?.t;
  const max = Math.max(...all.map((p) => p.depth), 1);
  const timeOf = (s) => new Date(s.replace(" ", "T")).getTime();
  const t0ms = timeOf(t0);
  const span = Math.max(timeOf(t1) - t0ms, 1);
  const xOf = (t) => CHART_PAD.l + ((timeOf(t) - t0ms) / span) * iw;
  const yOf = (d) => CHART_PAD.t + ih - (d / max) * ih;
  // 阶跃路径:每点水平延伸到下一点时刻再跳变;末点水平延伸到图右缘。
  let d = `M ${xOf(all[0].t)} ${yOf(all[0].depth)}`;
  for (let i = 1; i < all.length; i++) {
    d += ` L ${xOf(all[i].t)} ${yOf(all[i - 1].depth)} L ${xOf(all[i].t)} ${yOf(all[i].depth)}`;
  }
  d += ` L ${CHART_W - CHART_PAD.r} ${yOf(all[all.length - 1].depth)}`;
  const area = `${d} L ${CHART_W - CHART_PAD.r} ${CHART_PAD.t + ih} L ${xOf(all[0].t)} ${CHART_PAD.t + ih} Z`;
  return (
    <ChartFrame x0={t0} x1={t1} unit={`峰 ${max}`}>
      <path d={area} fill={c.primary} opacity="0.12" />
      <path d={d} fill="none" stroke={c.primary} strokeWidth="1.5" />
      {all.map((p, i) =>
        p.depth > 0 ? (
          <circle key={i} cx={xOf(p.t)} cy={yOf(p.depth)} r="2.5" fill={c.primary}>
            <title>{`${p.t} 深度 ${p.depth}`}</title>
          </circle>
        ) : null
      )}
    </ChartFrame>
  );
}
